#!/usr/bin/env python3
from __future__ import annotations

import argparse
import csv
import importlib.util
import json
import sys
from pathlib import Path
from typing import Any

import math
import pandas as pd

ROOT = Path(__file__).resolve().parents[1]
CONFIG_PATH = ROOT / "config" / "execution" / "rank213_live_canary.yaml"
DRYRUN_PATH = ROOT / "scripts" / "run_rank213_largecap_xs_jump_veto_live_dryrun.py"


def load_module(path: Path, name: str):
    spec = importlib.util.spec_from_file_location(name, path)
    mod = importlib.util.module_from_spec(spec)
    assert spec.loader is not None
    sys.modules[name] = mod
    spec.loader.exec_module(mod)
    return mod


dryrun_mod = load_module(DRYRUN_PATH, "rank213_live_dryrun_mod")
phase6_mod = load_module(ROOT / "scripts" / "run_rank32b_canary_phase6.py", "rank32b_phase6_mod")


def build_shell_paths(cfg: dict[str, Any]) -> dict[str, Path]:
    base = dryrun_mod.build_artifact_paths(cfg)
    root = base["root"].with_name(base["root"].name + "_shell")
    return {
        "root": root,
        "events": root / "live_events.jsonl",
        "status": root / "live_status.json",
        "state": root / "live_state.json",
        "intentions": root / "live_recent_intentions.json",
        "orders": root / "live_recent_orders.json",
        "rejections": root / "live_recent_rejections.json",
        "warnings": root / "live_warnings.json",
        "compare": root / "live_vs_shadow.csv",
        "compare_summary": root / "live_vs_shadow_summary.json",
        "operator_packet": root / "live_operator_packet.json",
        "run_summary": root / "live_last_run_summary.json",
        "exchange_positions": root / "live_exchange_positions.json",
        "config_snapshot": root / "rank213_live_canary_shell_config_snapshot.yaml",
    }


def _residual_flatten_history_summary(history: list[dict[str, Any]]) -> dict[str, Any]:
    total_flattened = 0
    symbols: set[str] = set()
    last_event: dict[str, Any] | None = None
    for row in history:
        if not isinstance(row, dict):
            continue
        total_flattened += int(row.get("flattened_count", 0) or 0)
        for symbol in row.get("symbols", []) if isinstance(row.get("symbols"), list) else []:
            symbol_s = str(symbol or "").upper().strip()
            if symbol_s:
                symbols.add(symbol_s)
        event_ts = str(row.get("flattened_at_utc") or "")
        if event_ts and (last_event is None or event_ts >= str(last_event.get("flattened_at_utc") or "")):
            last_event = row
    return {
        "event_count": len(history),
        "total_flattened_count": total_flattened,
        "last_flattened_at_utc": last_event.get("flattened_at_utc") if isinstance(last_event, dict) else None,
        "last_flatten_reason": last_event.get("flatten_reason") if isinstance(last_event, dict) else None,
        "symbols": sorted(symbols),
    }


def _record_residual_flatten_history(*, shell_state: dict[str, Any], residual_flatten_orders: list[dict[str, Any]], exchange_reconciliation: dict[str, Any], flatten_reason: str | None, run_at_utc: str) -> tuple[list[dict[str, Any]], dict[str, Any]]:
    existing = shell_state.get("residual_flatten_history", [])
    history = [row for row in existing if isinstance(row, dict)] if isinstance(existing, list) else []
    if residual_flatten_orders:
        orders = [row for row in residual_flatten_orders if isinstance(row, dict)]
        symbols = sorted({str(row.get("symbol") or "").upper().strip() for row in orders if str(row.get("symbol") or "").strip()})
        symbol_set = set(symbols)
        source_positions = [
            row for row in exchange_reconciliation.get("positions", [])
            if isinstance(row, dict) and str(row.get("symbol") or "").upper().strip() in symbol_set
        ] if isinstance(exchange_reconciliation.get("positions"), list) else []
        history.append({
            "flattened_at_utc": run_at_utc,
            "flatten_reason": flatten_reason,
            "flattened_count": len(orders),
            "symbols": symbols,
            "order_roles": sorted({str(row.get("order_role") or "") for row in orders if str(row.get("order_role") or "")}),
            "reconciliation_classifications": sorted({str(row.get("reconciliation_classification") or "") for row in source_positions if str(row.get("reconciliation_classification") or "")}),
            "source_positions": source_positions,
            "orders": orders,
        })
    history = history[-50:]
    return history, _residual_flatten_history_summary(history)


def write_compare_csv(path: Path, *, run_at_utc: str, current: dict[str, Any], accepted: bool, rejection_reasons: list[dict[str, Any]], basket_metrics: dict[str, Any], live_shell_armed: bool, official_window: dict[str, Any], submit_stats: dict[str, Any] | None = None) -> None:
    dryrun_mod.ensure_dir(path.parent)
    submit_stats = submit_stats or {}
    rows = [{
        "run_at_utc": run_at_utc,
        "bar_key": current.get("bar_key"),
        "decision_ts": current.get("decision_ts"),
        "planned_exit_ts": current.get("planned_exit_ts"),
        "shadow_decision": current.get("decision"),
        "shadow_gate_on": current.get("gate_on"),
        "shadow_longs": ",".join(current.get("longs", [])),
        "shadow_shorts": ",".join(current.get("shorts", [])),
        "live_shell_status": (
            "incomplete_non_comparable"
            if int(submit_stats.get("legs_unmaterialized", 0)) > 0 and int(submit_stats.get("legs_materialized", 0)) > 0
            else (
                "partial_submit"
                if int(submit_stats.get("legs_submitted", 0)) > 0 and int(submit_stats.get("legs_submit_failed", 0)) > 0
                else ("armed" if live_shell_armed else ("accepted_preview" if accepted else "rejected"))
            )
        ),
        "official_entry_window_reason": official_window.get("reason"),
        "rejection_reasons": ";".join(sorted({str(x.get('reason')) for x in rejection_reasons})),
        "intent_leg_count": len(current.get("longs", [])) + len(current.get("shorts", [])),
        "long_nominal_usdt": basket_metrics.get("long_nominal_usdt"),
        "short_nominal_usdt": basket_metrics.get("short_nominal_usdt"),
        "gross_nominal_usdt": basket_metrics.get("gross_nominal_usdt"),
        "nominal_imbalance_usdt": basket_metrics.get("nominal_imbalance_usdt"),
        "side_imbalance_usdt": basket_metrics.get("side_imbalance_usdt"),
        "missing_legs_total": basket_metrics.get("missing_legs_total"),
        "target_leg_notional_floor_usdt": basket_metrics.get("target_leg_notional_floor_usdt"),
        "legs_materialized": submit_stats.get("legs_materialized", 0),
        "legs_unmaterialized": submit_stats.get("legs_unmaterialized", 0),
        "unmaterialized_symbols": ",".join(submit_stats.get("unmaterialized_symbols", [])),
        "basket_comparable": bool(submit_stats.get("basket_comparable", False)),
    }]
    with path.open("w", encoding="utf-8", newline="") as f:
        writer = csv.DictWriter(f, fieldnames=list(rows[0].keys()))
        writer.writeheader()
        writer.writerows(rows)


def build_preview_orders(intentions: list[dict[str, Any]], cfg: dict[str, Any], *, run_at_utc: str, live_shell_armed: bool, basket_id: str | None) -> list[dict[str, Any]]:
    execution = cfg.get("execution", {}) if isinstance(cfg.get("execution"), dict) else {}
    rows: list[dict[str, Any]] = []
    for item in intentions:
        rows.append({
            "timestamp": run_at_utc,
            "basket_id": basket_id,
            "symbol": item.get("symbol"),
            "side": "BUY" if item.get("side") == "long" else "SELL",
            "order_role": "entry_preview",
            "order_type": str(execution.get("order_type", "post_only_limit")),
            "post_only": bool(execution.get("post_only", True)),
            "maker_first": bool(execution.get("maker_first", True)),
            "ttl_seconds": int(execution.get("ttl_seconds", 20)),
            "fallback_order_type": str(execution.get("fallback_order_type", "market")),
            "target_notional_usdt": item.get("target_notional_usdt"),
            "basket_role": item.get("basket_role"),
            "status": "LIVE_ARMED_PREVIEW" if live_shell_armed else "PREVIEW_ONLY",
        })
    return rows


def build_exec_cfg(cfg: dict[str, Any], intentions: list[dict[str, Any]]) -> dict[str, Any]:
    phase6_cfg = cfg.get("phase6", {}) if isinstance(cfg.get("phase6"), dict) else {}
    out = json.loads(json.dumps(cfg))
    out.setdefault("phase6", {})
    out["phase6"].update(json.loads(json.dumps(phase6_cfg)))
    out["universe"] = {"symbols": [str(row.get("symbol") or "").upper() for row in intentions if row.get("symbol")]}
    return out


def classify_bridge_entry_failure(exc: Exception) -> tuple[str, str]:
    text = str(exc)
    if "-5022" in text or "Post Only order will be rejected" in text:
        return "maker_rejected_post_only", text
    return "bridge_entry_failed", text


def _extract_price_tick_size(rules: Any) -> float | None:
    if isinstance(rules, dict):
        tick = phase6_mod.safe_float(rules.get("tickSize"))
        if tick > 0:
            return tick
        filters = rules.get("filters")
        if isinstance(filters, list):
            for row in filters:
                if not isinstance(row, dict):
                    continue
                if str(row.get("filterType") or "").upper() != "PRICE_FILTER":
                    continue
                tick = phase6_mod.safe_float(row.get("tickSize"))
                if tick > 0:
                    return tick
    return None


def _quantize_price_to_tick(price: float, tick_size: float | None, *, mode: str) -> float:
    if not math.isfinite(price) or price <= 0:
        return price
    if tick_size is None or not math.isfinite(tick_size) or tick_size <= 0:
        return price
    scaled = price / tick_size
    if mode == "down":
        steps = math.floor(scaled + 1e-12)
    elif mode == "up":
        steps = math.ceil(scaled - 1e-12)
    else:
        steps = round(scaled)
    return max(tick_size, steps * tick_size)


def _extract_best_bid_ask(payload: Any) -> tuple[float | None, float | None]:
    if not isinstance(payload, dict):
        return None, None
    bid = phase6_mod.safe_float(payload.get("bidPrice"), math.nan)
    ask = phase6_mod.safe_float(payload.get("askPrice"), math.nan)
    if not math.isfinite(bid) or bid <= 0:
        bid = phase6_mod.safe_float(payload.get("bid"), math.nan)
    if not math.isfinite(ask) or ask <= 0:
        ask = phase6_mod.safe_float(payload.get("ask"), math.nan)
    best_bid = bid if math.isfinite(bid) and bid > 0 else None
    best_ask = ask if math.isfinite(ask) and ask > 0 else None
    return best_bid, best_ask


def _get_best_bid_ask(bridge: Any, symbol: str) -> tuple[float | None, float | None]:
    method_names = [
        "get_binance_perp_book_ticker",
        "get_binance_perp_ticker_book",
        "get_binance_perp_bookticker",
        "get_binance_perp_book_tickers",
    ]
    for method_name in method_names:
        method = getattr(bridge, method_name, None)
        if not callable(method):
            continue
        try:
            payload = method(symbol=symbol)
        except TypeError:
            try:
                payload = method(symbol)
            except Exception:
                continue
        except Exception:
            continue
        if isinstance(payload, list):
            payload = payload[0] if payload else None
        best_bid, best_ask = _extract_best_bid_ask(payload)
        if best_bid is not None or best_ask is not None:
            return best_bid, best_ask
    return None, None


def _resolve_entry_policy(cfg: dict[str, Any], phase6_cfg: dict[str, Any]) -> dict[str, Any]:
    entry_cfg = phase6_cfg.get("entry", {}) if isinstance(phase6_cfg.get("entry"), dict) else {}
    execution_cfg = cfg.get("execution", {}) if isinstance(cfg.get("execution"), dict) else {}
    ttl_seconds = phase6_mod.safe_float(entry_cfg.get("ttl_seconds"), math.nan)
    ttl_source = "phase6.entry.ttl_seconds"
    if not math.isfinite(ttl_seconds) or ttl_seconds <= 0:
        ttl_minutes = phase6_mod.safe_float(entry_cfg.get("ttl_minutes"), math.nan)
        if math.isfinite(ttl_minutes) and ttl_minutes > 0:
            ttl_seconds = ttl_minutes * 60.0
            ttl_source = "phase6.entry.ttl_minutes"
        else:
            ttl_seconds = phase6_mod.safe_float(execution_cfg.get("ttl_seconds"), 20.0)
            ttl_source = "execution.ttl_seconds"
    return {
        "mode": str(entry_cfg.get("mode") or "maker_once_then_market"),
        "ttl_seconds": max(1, int(round(ttl_seconds))),
        "ttl_source": ttl_source,
        "post_only_reject_policy": str(entry_cfg.get("post_only_reject_policy") or "immediate_market"),
        "allow_price_improvement_precheck": bool(entry_cfg.get("allow_price_improvement_precheck", True)),
        "max_reprices": int(entry_cfg.get("max_reprices", 0) or 0),
        "fallback_to_market_on_ttl": bool(entry_cfg.get("fallback_to_market_on_ttl", True)),
    }


def _compute_post_only_safe_price(*, side: str, intended_price: float, best_bid: float | None, best_ask: float | None, tick_size: float | None, allow_price_improvement_precheck: bool) -> dict[str, Any]:
    quantize_mode = "down" if side == "long" else "up"
    quantized_intended = _quantize_price_to_tick(intended_price, tick_size, mode=quantize_mode)
    out = {
        "intended_price": intended_price,
        "quantized_price": quantized_intended,
        "final_price": quantized_intended,
        "best_bid": best_bid,
        "best_ask": best_ask,
        "tick_size": tick_size,
        "maker_price_adjusted_for_post_only_safety": False,
        "maker_adjustment_ticks": 0,
        "precheck_status": "no_book_ticker",
        "precheck_safe": True,
        "precheck_reason": None,
    }
    if side == "long":
        if best_ask is None or best_ask <= 0:
            return out
        if quantized_intended < best_ask:
            out["precheck_status"] = "safe"
            return out
        if not allow_price_improvement_precheck or tick_size is None or tick_size <= 0:
            out["precheck_status"] = "crossing_without_adjustment"
            out["precheck_safe"] = False
            out["precheck_reason"] = "maker_price_would_cross_ask"
            return out
        safer_price = _quantize_price_to_tick(best_ask - tick_size, tick_size, mode="down")
        if safer_price > 0 and safer_price < best_ask:
            out["final_price"] = safer_price
            out["maker_price_adjusted_for_post_only_safety"] = not math.isclose(safer_price, quantized_intended, rel_tol=0.0, abs_tol=max(1e-12, (tick_size or 0.0) / 10.0))
            out["maker_adjustment_ticks"] = int(round((safer_price - quantized_intended) / tick_size)) if tick_size else 0
            out["precheck_status"] = "adjusted_safe" if out["maker_price_adjusted_for_post_only_safety"] else "safe"
            return out
        out["precheck_status"] = "unsafe_after_adjustment"
        out["precheck_safe"] = False
        out["precheck_reason"] = "maker_price_would_cross_ask"
        return out
    if best_bid is None or best_bid <= 0:
        return out
    if quantized_intended > best_bid:
        out["precheck_status"] = "safe"
        return out
    if not allow_price_improvement_precheck or tick_size is None or tick_size <= 0:
        out["precheck_status"] = "crossing_without_adjustment"
        out["precheck_safe"] = False
        out["precheck_reason"] = "maker_price_would_cross_bid"
        return out
    safer_price = _quantize_price_to_tick(best_bid + tick_size, tick_size, mode="up")
    if safer_price > best_bid:
        out["final_price"] = safer_price
        out["maker_price_adjusted_for_post_only_safety"] = not math.isclose(safer_price, quantized_intended, rel_tol=0.0, abs_tol=max(1e-12, (tick_size or 0.0) / 10.0))
        out["maker_adjustment_ticks"] = int(round((safer_price - quantized_intended) / tick_size)) if tick_size else 0
        out["precheck_status"] = "adjusted_safe" if out["maker_price_adjusted_for_post_only_safety"] else "safe"
        return out
    out["precheck_status"] = "unsafe_after_adjustment"
    out["precheck_safe"] = False
    out["precheck_reason"] = "maker_price_would_cross_bid"
    return out


def build_pending_entry_row(bridge: Any, cfg: dict[str, Any], phase6_cfg: dict[str, Any], intention: dict[str, Any], *, run_at_utc: str, run_dt: Any, trace_id: str, current_config_version: str, current_code_version: str) -> dict[str, Any]:
    symbol = str(intention.get("symbol") or "").upper()
    side = str(intention.get("side") or "")
    target_notional = float(intention.get("target_notional_usdt") or 0.0)
    rules = bridge.get_binance_perp_trade_rules(symbol)
    last_price = bridge.get_binance_perp_last_price(symbol)
    sizing_floor = bridge.estimate_binance_min_trade_floor(symbol, last_price=last_price, rules=rules)
    floor_notional = phase6_mod.safe_float(sizing_floor.get("effective_min_notional"), 5.0)
    buffer_mult = max(1.0, float(phase6_cfg.get("sizing", {}).get("min_notional_buffer_mult", 1.0)))
    target_notional = max(target_notional, floor_notional * buffer_mult)
    qty_info = bridge.derive_binance_qty_from_notional(symbol, target_notional, last_price=last_price, rules=rules)
    quantity = phase6_mod.safe_float(qty_info.get("quantity"))
    entry_policy = _resolve_entry_policy(cfg, phase6_cfg)
    fallback_to_market = bool(entry_policy.get("fallback_to_market_on_ttl", True))

    intended_price = last_price
    order_type = str(phase6_cfg.get("entry", {}).get("order_type", "market")).lower()
    requested_offset_bps = phase6_mod.safe_float(phase6_cfg.get("entry", {}).get("limit_offset_bps", 2.0), 2.0)
    if order_type == "limit_gtx":
        if side == "long":
            intended_price = intended_price * (1.0 - requested_offset_bps / 10000.0)
        else:
            intended_price = intended_price * (1.0 + requested_offset_bps / 10000.0)

    tick_size = _extract_price_tick_size(rules)
    best_bid, best_ask = _get_best_bid_ask(bridge, symbol) if order_type == "limit_gtx" else (None, None)
    post_only_precheck = _compute_post_only_safe_price(
        side=side,
        intended_price=intended_price,
        best_bid=best_bid,
        best_ask=best_ask,
        tick_size=tick_size,
        allow_price_improvement_precheck=bool(entry_policy.get("allow_price_improvement_precheck", True)),
    ) if order_type == "limit_gtx" else {
        "intended_price": intended_price,
        "quantized_price": intended_price,
        "final_price": intended_price,
        "best_bid": best_bid,
        "best_ask": best_ask,
        "tick_size": tick_size,
        "maker_price_adjusted_for_post_only_safety": False,
        "maker_adjustment_ticks": 0,
        "precheck_status": "not_applicable",
        "precheck_safe": True,
        "precheck_reason": None,
    }
    maker_submit_price = phase6_mod.safe_float(post_only_precheck.get("final_price"), intended_price)

    leverage_guard = phase6_mod.ensure_binance_leverage(
        bridge,
        symbol=symbol,
        signal_side=side,
        target_leverage=max(1, int(phase6_mod.safe_float(phase6_cfg.get("default_leverage", 1), 1))),
    )
    run_ctx = phase6_mod.RunContext(now_iso=run_at_utc, now_dt=run_dt)
    client_order_id = phase6_mod.make_client_order_id("en", symbol, run_ctx, trace_id)
    order_side = phase6_mod.signal_to_order_side(side)
    entry_expires_at = (run_dt + pd.Timedelta(seconds=int(entry_policy.get("ttl_seconds", 20)))).strftime("%Y-%m-%dT%H:%M:%SZ")

    def build_pending_payload(entry_n: dict[str, Any], *, planned_qty: float, entry_expires_at: str, fallback_used: bool, rejected_post_only: bool = False, rejected_order_error: str | None = None, rejected_client_order_id: str | None = None, fallback_reason: str | None = None, submit_outcome: str | None = None) -> dict[str, Any]:
        return {
            "trace_id": trace_id,
            "signal_id": intention.get("intention_id"),
            "signal_timestamp": intention.get("decision_ts"),
            "signal_confirmed_at": intention.get("decision_ts"),
            "intention_id": intention.get("intention_id"),
            "symbol": symbol,
            "side": side,
            "basket_id": intention.get("basket_id"),
            "basket_role": intention.get("basket_role"),
            "planned_exit_ts": intention.get("planned_exit_ts"),
            "hold_bars": 12,
            "horizon_bar_minutes": 15,
            "exit_policy": "rank213_horizon_market",
            "code_version": current_code_version,
            "config_version": current_config_version,
            "entry_order_id": entry_n.get("order_id"),
            "entry_client_order_id": entry_n.get("client_order_id") or client_order_id,
            "planned_qty": planned_qty,
            "planned_notional": target_notional,
            "signal_price": last_price,
            "atr14": None,
            "entry_submit_at": run_at_utc,
            "entry_expires_at": entry_expires_at,
            "entry_fallback_used": fallback_used,
            "entry_rejected_post_only": rejected_post_only,
            "entry_rejected_order_error": rejected_order_error,
            "entry_rejected_client_order_id": rejected_client_order_id,
            "entry_policy_mode": entry_policy.get("mode"),
            "entry_ttl_seconds": int(entry_policy.get("ttl_seconds", 20)),
            "entry_ttl_source": entry_policy.get("ttl_source"),
            "post_only_reject_policy": entry_policy.get("post_only_reject_policy"),
            "fallback_to_market_on_ttl": bool(entry_policy.get("fallback_to_market_on_ttl", True)),
            "maker_attempt_count": 1,
            "maker_price_quantized": post_only_precheck.get("quantized_price"),
            "maker_submit_price": maker_submit_price,
            "maker_price_adjusted_for_post_only_safety": bool(post_only_precheck.get("maker_price_adjusted_for_post_only_safety", False)),
            "maker_adjustment_ticks": int(post_only_precheck.get("maker_adjustment_ticks", 0) or 0),
            "best_bid_at_submit": post_only_precheck.get("best_bid"),
            "best_ask_at_submit": post_only_precheck.get("best_ask"),
            "maker_offset_bps_requested": requested_offset_bps,
            "maker_offset_bps_effective": ((last_price - maker_submit_price) / last_price * 10000.0) if side == "long" and last_price else ((maker_submit_price - last_price) / last_price * 10000.0) if last_price else None,
            "post_only_precheck_status": post_only_precheck.get("precheck_status"),
            "post_only_precheck_safe": bool(post_only_precheck.get("precheck_safe", True)),
            "post_only_precheck_reason": post_only_precheck.get("precheck_reason"),
            "submit_outcome": submit_outcome or ("maker_submitted" if order_type == "limit_gtx" else "market_submitted"),
            "fallback_reason": fallback_reason,
            "basket_leg_materialized": False,
            "basket_leg_materialization_path": "maker_pending",
            "basket_leg_comparable": True,
            "basket_incomplete_reason": None,
            "target_notional_usdt": target_notional,
        }

    def build_live_payload(entry_n: dict[str, Any], *, filled_qty: float, fallback_used: bool, rejected_post_only: bool = False, rejected_order_error: str | None = None, rejected_client_order_id: str | None = None, fallback_reason: str | None = None, submit_outcome: str | None = None) -> dict[str, Any]:
        entry_price = phase6_mod.safe_float(entry_n.get("avg_price"), phase6_mod.safe_float(entry_n.get("price"), last_price))
        return {
            "trace_id": trace_id,
            "signal_id": intention.get("intention_id"),
            "signal_timestamp": intention.get("decision_ts"),
            "signal_price": last_price,
            "signal_confirmed_at": phase6_mod.signal_confirmed_at(
                str(intention.get("decision_ts") or ""),
                {"signal_confirmed_at_override": str(intention.get("decision_ts") or "") or None},
            ),
            "intention_id": intention.get("intention_id"),
            "symbol": symbol,
            "side": side,
            "code_version": current_code_version,
            "config_version": current_config_version,
            "entry_order_id": entry_n.get("order_id"),
            "entry_client_order_id": entry_n.get("client_order_id") or client_order_id,
            "entry_time": run_at_utc,
            "entry_price": entry_price,
            "entry_qty": filled_qty,
            "entry_notional": filled_qty * entry_price,
            "entry_latency_seconds": 0.0,
            "basket_id": intention.get("basket_id"),
            "basket_role": intention.get("basket_role"),
            "planned_exit_ts": intention.get("planned_exit_ts"),
            "hold_bars": 12,
            "horizon_bar_minutes": 15,
            "exit_policy": "rank213_horizon_market",
            "entry_policy_mode": entry_policy.get("mode"),
            "entry_ttl_seconds": int(entry_policy.get("ttl_seconds", 20)),
            "entry_ttl_source": entry_policy.get("ttl_source"),
            "post_only_reject_policy": entry_policy.get("post_only_reject_policy"),
            "maker_attempt_count": 1,
            "maker_price_quantized": post_only_precheck.get("quantized_price"),
            "maker_submit_price": maker_submit_price,
            "maker_price_adjusted_for_post_only_safety": bool(post_only_precheck.get("maker_price_adjusted_for_post_only_safety", False)),
            "maker_adjustment_ticks": int(post_only_precheck.get("maker_adjustment_ticks", 0) or 0),
            "best_bid_at_submit": post_only_precheck.get("best_bid"),
            "best_ask_at_submit": post_only_precheck.get("best_ask"),
            "maker_offset_bps_requested": requested_offset_bps,
            "maker_offset_bps_effective": ((last_price - maker_submit_price) / last_price * 10000.0) if side == "long" and last_price else ((maker_submit_price - last_price) / last_price * 10000.0) if last_price else None,
            "post_only_precheck_status": post_only_precheck.get("precheck_status"),
            "post_only_precheck_safe": bool(post_only_precheck.get("precheck_safe", True)),
            "post_only_precheck_reason": post_only_precheck.get("precheck_reason"),
            "submit_outcome": submit_outcome or ("maker_submitted" if order_type == "limit_gtx" else "market_submitted"),
            "fallback_reason": fallback_reason,
            "entry_fallback_used": fallback_used,
            "entry_rejected_post_only": rejected_post_only,
            "entry_rejected_order_error": rejected_order_error,
            "entry_rejected_client_order_id": rejected_client_order_id,
            "basket_leg_materialized": True,
            "basket_leg_materialization_path": (
                "immediate_market_fallback" if fallback_used else ("maker_filled" if order_type == "limit_gtx" else "market_direct")
            ),
            "basket_leg_comparable": True,
            "basket_incomplete_reason": None,
            "target_notional_usdt": target_notional,
            "timeout_exit_order_id": None,
            "tp_order_id": None,
            "sl_order_id": None,
        }

    def build_order_row(entry_n: dict[str, Any], *, order_role: str, order_type_label: str, lineage: str | None = None, transport: str | None = None, notes: dict[str, Any] | None = None) -> dict[str, Any]:
        row = {
            "timestamp": run_at_utc,
            "basket_id": intention.get("basket_id"),
            "intention_id": intention.get("intention_id"),
            "trace_id": trace_id,
            "symbol": symbol,
            "side": order_side,
            "order_role": order_role,
            "order_type": order_type_label,
            "price": entry_n.get("avg_price") or entry_n.get("price"),
            "qty": entry_n.get("executed_qty") or entry_n.get("orig_qty"),
            "status": entry_n.get("status"),
            "exchange_order_id": entry_n.get("order_id"),
            "client_order_id": entry_n.get("client_order_id"),
        }
        if lineage:
            row["lineage"] = lineage
        if transport:
            row["transport"] = transport
        if notes:
            row["notes"] = notes
        return row

    if order_type == "limit_gtx":
        if not bool(post_only_precheck.get("precheck_safe", True)):
            if entry_policy.get("post_only_reject_policy") != "immediate_market" or not fallback_to_market:
                raise RuntimeError(f"maker precheck rejected without market fallback for {symbol}: {post_only_precheck.get('precheck_reason')}")
            fallback_cid = phase6_mod.make_client_order_id("fb", symbol, run_ctx, trace_id)
            try:
                market_entry = bridge.place_binance_perp_live_market_order(
                    symbol=symbol,
                    side=order_side,
                    quantity=quantity,
                    reduce_only=None,
                    position_side=phase6_mod.hedge_position_side(side),
                    client_order_id=fallback_cid,
                )
            except Exception as fallback_exc:
                fallback_text = str(fallback_exc)
                raise RuntimeError(
                    f"maker precheck bypassed but fallback market failed for {symbol}: precheck_reason={post_only_precheck.get('precheck_reason')}; fallback_error={fallback_text}"
                ) from fallback_exc
            entry_n = phase6_mod.normalize_order_payload(market_entry, source="rank213_entry_precheck_bypass_fallback_market")
            live_row = compute_entry_outcome_fields(row=build_live_payload(
                entry_n,
                filled_qty=phase6_mod.safe_float(entry_n.get("executed_qty"), quantity),
                fallback_used=True,
                fallback_reason="maker_precheck_bypassed",
                submit_outcome="maker_precheck_bypassed_to_market",
            ) | {
                "fallback_submitted_at": run_at_utc,
                "fallback_fill_qty": phase6_mod.safe_float(entry_n.get("executed_qty"), quantity),
                "fallback_fill_price": phase6_mod.safe_float(entry_n.get("avg_price"), phase6_mod.safe_float(entry_n.get("price"), last_price)),
                "final_entry_status": "fallback_filled",
            }, now_iso=run_at_utc)
            bypass_order_row = {
                "timestamp": run_at_utc,
                "basket_id": intention.get("basket_id"),
                "intention_id": intention.get("intention_id"),
                "trace_id": trace_id,
                "symbol": symbol,
                "side": order_side,
                "order_role": "entry_precheck_bypassed",
                "order_type": "LIMIT_GTX",
                "price": maker_submit_price,
                "qty": quantity,
                "status": "BYPASSED_TO_MARKET",
                "exchange_order_id": None,
                "client_order_id": client_order_id,
                "lineage": "maker_precheck_bypassed_before_submit",
                "notes": {
                    "best_bid": best_bid,
                    "best_ask": best_ask,
                    "precheck": post_only_precheck,
                },
            }
            fallback_order_row = build_order_row(
                entry_n,
                order_role="entry_fallback",
                order_type_label="MARKET",
                lineage="maker_precheck_bypassed_to_market",
                notes={"fallback_reason": "maker_precheck_bypassed"},
            )
            return {
                "ok": True,
                "pending_row": None,
                "live_row": live_row,
                "order_row": fallback_order_row,
                "order_rows": [bypass_order_row, fallback_order_row],
                "leverage_guard": leverage_guard,
                "fallback_used": True,
            }
        try:
            entry_order = bridge.place_binance_perp_live_limit_gtx_order(
                symbol=symbol,
                side=order_side,
                quantity=quantity,
                price=maker_submit_price,
                reduce_only=None,
                position_side=phase6_mod.hedge_position_side(side),
                client_order_id=client_order_id,
                time_in_force=str(phase6_cfg.get("entry", {}).get("time_in_force", "GTX")),
            )
        except Exception as exc:
            failure_reason, error_text = classify_bridge_entry_failure(exc)
            if failure_reason != "maker_rejected_post_only" or entry_policy.get("post_only_reject_policy") != "immediate_market" or not fallback_to_market:
                raise
            fallback_cid = phase6_mod.make_client_order_id("fb", symbol, run_ctx, trace_id)
            try:
                market_entry = bridge.place_binance_perp_live_market_order(
                    symbol=symbol,
                    side=order_side,
                    quantity=quantity,
                    reduce_only=None,
                    position_side=phase6_mod.hedge_position_side(side),
                    client_order_id=fallback_cid,
                )
            except Exception as fallback_exc:
                fallback_text = str(fallback_exc)
                raise RuntimeError(
                    f"maker rejected post-only and fallback market failed for {symbol}: maker_error={error_text}; fallback_error={fallback_text}"
                ) from fallback_exc
            entry_n = phase6_mod.normalize_order_payload(market_entry, source="rank213_entry_submit_reject_fallback_market")
            live_row = compute_entry_outcome_fields(row=build_live_payload(
                entry_n,
                filled_qty=phase6_mod.safe_float(entry_n.get("executed_qty"), quantity),
                fallback_used=True,
                rejected_post_only=True,
                rejected_order_error=error_text,
                rejected_client_order_id=client_order_id,
                fallback_reason="maker_submit_rejected_post_only",
                submit_outcome="maker_submit_rejected_post_only",
            ) | {
                "fallback_submitted_at": run_at_utc,
                "fallback_fill_qty": phase6_mod.safe_float(entry_n.get("executed_qty"), quantity),
                "fallback_fill_price": phase6_mod.safe_float(entry_n.get("avg_price"), phase6_mod.safe_float(entry_n.get("price"), last_price)),
                "post_only_reject_detected": True,
                "submit_error_code": "-5022" if "-5022" in error_text else None,
                "submit_error_text": error_text,
                "final_entry_status": "fallback_filled",
            }, now_iso=run_at_utc)
            rejected_order_row = {
                "timestamp": run_at_utc,
                "basket_id": intention.get("basket_id"),
                "intention_id": intention.get("intention_id"),
                "trace_id": trace_id,
                "symbol": symbol,
                "side": order_side,
                "order_role": "entry_rejected_post_only",
                "order_type": "LIMIT_GTX",
                "price": maker_submit_price,
                "qty": quantity,
                "status": "REJECTED_POST_ONLY",
                "exchange_order_id": None,
                "client_order_id": client_order_id,
                "lineage": "maker_submit_rejected_before_accept",
                "notes": {
                    "error": error_text,
                    "fallback_client_order_id": entry_n.get("client_order_id") or fallback_cid,
                    "best_bid": best_bid,
                    "best_ask": best_ask,
                    "precheck": post_only_precheck,
                },
            }
            fallback_order_row = build_order_row(
                entry_n,
                order_role="entry_fallback",
                order_type_label="MARKET",
                lineage="post_only_reject_immediate_fallback",
                notes={"fallback_reason": "maker_submit_rejected_post_only"},
            )
            return {
                "ok": True,
                "pending_row": None,
                "live_row": live_row,
                "order_row": fallback_order_row,
                "order_rows": [rejected_order_row, fallback_order_row],
                "leverage_guard": leverage_guard,
                "fallback_used": True,
            }
        entry_n = phase6_mod.normalize_order_payload(entry_order, source="rank213_entry_limit")
        pending_row = compute_entry_outcome_fields(row=build_pending_payload(
            entry_n,
            planned_qty=quantity,
            entry_expires_at=entry_expires_at,
            fallback_used=False,
            submit_outcome="maker_submitted",
        ) | {
            "final_entry_status": "pending_entry",
            "final_entry_qty": phase6_mod.safe_float(entry_n.get("executed_qty"), 0.0),
        }, now_iso=run_at_utc)
        accepted_order_row = build_order_row(
            entry_n,
            order_role="entry",
            order_type_label="LIMIT",
            lineage="maker_submit_accepted",
            notes={"precheck": post_only_precheck},
        )
        return {
            "ok": True,
            "pending_row": pending_row,
            "order_row": accepted_order_row,
            "order_rows": [accepted_order_row],
            "leverage_guard": leverage_guard,
            "fallback_used": False,
        }

    entry_order = bridge.place_binance_perp_live_market_order(
        symbol=symbol,
        side=order_side,
        quantity=quantity,
        reduce_only=None,
        position_side=phase6_mod.hedge_position_side(side),
        client_order_id=client_order_id,
    )
    entry_n = phase6_mod.normalize_order_payload(entry_order, source="rank213_entry_market")
    live_row = compute_entry_outcome_fields(row=build_live_payload(
        entry_n,
        filled_qty=phase6_mod.safe_float(entry_n.get("executed_qty"), quantity),
        fallback_used=False,
        submit_outcome="market_submitted",
    ) | {
        "final_entry_status": "live_open",
    }, now_iso=run_at_utc)
    market_order_row = build_order_row(
        entry_n,
        order_role="entry",
        order_type_label="MARKET",
        lineage="direct_market_submit",
    )
    return {
        "ok": True,
        "pending_row": None,
        "live_row": live_row,
        "order_row": market_order_row,
        "order_rows": [market_order_row],
        "leverage_guard": leverage_guard,
        "fallback_used": False,
    }


def build_basket_metadata_index(*row_groups: list[dict[str, Any]]) -> dict[str, dict[str, Any]]:
    by_trace_id: dict[str, dict[str, Any]] = {}
    by_intention_id: dict[str, dict[str, Any]] = {}
    by_signal_id: dict[str, dict[str, Any]] = {}
    by_symbol_side: dict[str, dict[str, Any]] = {}
    for rows in row_groups:
        for row in rows:
            if not isinstance(row, dict):
                continue
            meta = {
                "basket_id": row.get("basket_id"),
                "basket_role": row.get("basket_role"),
                "planned_exit_ts": row.get("planned_exit_ts"),
                "target_notional_usdt": row.get("target_notional_usdt") if row.get("target_notional_usdt") is not None else row.get("planned_notional"),
                "signal_price": row.get("signal_price"),
                "decision_ts": row.get("decision_ts") if row.get("decision_ts") is not None else row.get("signal_timestamp"),
            }
            if not meta["basket_id"] and not meta["basket_role"]:
                continue
            trace_id = str(row.get("trace_id") or "").strip()
            intention_id = str(row.get("intention_id") or "").strip()
            signal_id = str(row.get("signal_id") or "").strip()
            symbol = str(row.get("symbol") or "").upper().strip()
            side = str(row.get("side") or "").strip()
            if trace_id:
                by_trace_id.setdefault(trace_id, meta)
            if intention_id:
                by_intention_id.setdefault(intention_id, meta)
            if signal_id:
                by_signal_id.setdefault(signal_id, meta)
            if symbol and side:
                by_symbol_side[f"{symbol}|{side}"] = meta
    return {
        "by_trace_id": by_trace_id,
        "by_intention_id": by_intention_id,
        "by_signal_id": by_signal_id,
        "by_symbol_side": by_symbol_side,
    }



def sanitize_rank213_row(row: dict[str, Any]) -> dict[str, Any]:
    clean = dict(row)
    horizon_exit_order_id = clean.pop("timeout_exit_order_id", None)
    clean.pop("tp_order_id", None)
    clean.pop("sl_order_id", None)
    clean.pop("tp_price", None)
    clean.pop("sl_price", None)
    clean.pop("sl_soft_fallback_active", None)
    if horizon_exit_order_id is not None or "horizon_exit_order_id" in clean:
        clean["horizon_exit_order_id"] = clean.get("horizon_exit_order_id") or horizon_exit_order_id
    return clean



def compute_entry_outcome_fields(*, row: dict[str, Any], now_iso: str | None = None) -> dict[str, Any]:
    out = dict(row)
    signal_ts = phase6_mod.parse_utc(str(out.get("signal_timestamp") or ""))
    entry_submit_at = phase6_mod.parse_utc(str(out.get("entry_submit_at") or out.get("entry_time") or ""))
    entry_time = phase6_mod.parse_utc(str(out.get("entry_time") or ""))
    fallback_submitted_at = phase6_mod.parse_utc(str(out.get("fallback_submitted_at") or ""))
    ttl_expired_at = phase6_mod.parse_utc(str(out.get("ttl_expired_at") or ""))
    cancel_confirmed_at = phase6_mod.parse_utc(str(out.get("cancel_confirmed_at") or ""))
    observed_now = phase6_mod.parse_utc(str(now_iso or ""))

    final_entry_qty = phase6_mod.safe_float(
        out.get("final_entry_qty"),
        phase6_mod.safe_float(out.get("entry_qty"), phase6_mod.safe_float(out.get("executed_qty"), 0.0)),
    )
    out["final_entry_qty"] = final_entry_qty

    final_entry_vwap = out.get("final_entry_vwap")
    if final_entry_vwap is None:
        entry_price = phase6_mod.safe_float(out.get("entry_price"), math.nan)
        fallback_fill_qty = phase6_mod.safe_float(out.get("fallback_fill_qty"), 0.0)
        fallback_fill_price = phase6_mod.safe_float(out.get("fallback_fill_price"), math.nan)
        snapshot_executed_qty = phase6_mod.safe_float(out.get("snapshot_executed_qty_before_cancel"), 0.0)
        if final_entry_qty > 0:
            weighted_notional = 0.0
            if snapshot_executed_qty > 0 and math.isfinite(entry_price) and entry_price > 0:
                weighted_notional += snapshot_executed_qty * entry_price
            elif fallback_fill_qty <= 0 and math.isfinite(entry_price) and entry_price > 0:
                weighted_notional += final_entry_qty * entry_price
            if fallback_fill_qty > 0 and math.isfinite(fallback_fill_price) and fallback_fill_price > 0:
                weighted_notional += fallback_fill_qty * fallback_fill_price
            if weighted_notional > 0:
                final_entry_vwap = weighted_notional / final_entry_qty
    out["final_entry_vwap"] = final_entry_vwap

    if out.get("maker_to_fill_seconds") is None and signal_ts is not None and entry_time is not None:
        out["maker_to_fill_seconds"] = round(max(0.0, (entry_time - signal_ts).total_seconds()), 3)
    if out.get("ttl_to_market_seconds") is None and ttl_expired_at is not None and fallback_submitted_at is not None:
        out["ttl_to_market_seconds"] = round(max(0.0, (fallback_submitted_at - ttl_expired_at).total_seconds()), 3)

    final_status = str(out.get("final_entry_status") or "").strip()
    if not final_status:
        fallback_reason = str(out.get("fallback_reason") or "").strip()
        submit_outcome = str(out.get("submit_outcome") or "").strip()
        basket_status = str(out.get("basket_status") or "").strip()
        fallback_fill_qty = phase6_mod.safe_float(out.get("fallback_fill_qty"), 0.0)
        snapshot_executed_qty = phase6_mod.safe_float(out.get("snapshot_executed_qty_before_cancel"), 0.0)
        if basket_status == "pending_entries":
            final_status = "pending_entry"
        elif fallback_reason in {"maker_precheck_bypassed", "maker_submit_rejected_post_only", "ttl_cancel_then_market_fallback"} or fallback_fill_qty > 0:
            final_status = "fallback_filled"
        elif submit_outcome == "maker_submitted" and final_entry_qty > 0:
            final_status = "live_open"
        elif submit_outcome in {"maker_precheck_bypassed_to_market", "maker_submit_rejected_post_only"} and final_entry_qty > 0:
            final_status = "live_open"
        elif str(out.get("fallback_decision") or "") == "abandon_signal_stale":
            final_status = "stale_abandoned"
        elif str(out.get("fallback_decision") or "") == "abandon_basket_blocked":
            final_status = "basket_blocked_abandoned"
        elif str(out.get("fallback_decision") or "") == "abandon_after_ttl":
            final_status = "ttl_abandoned"
        elif snapshot_executed_qty > 0 and final_entry_qty > 0:
            final_status = "partially_filled"
        elif observed_now is not None and cancel_confirmed_at is not None and final_entry_qty <= 0:
            final_status = "cancelled_unfilled"
    if out.get("basket_leg_materialized") is None:
        out["basket_leg_materialized"] = final_status in {"pending_entry", "live_open", "fallback_filled", "partially_filled", "closed"}
    if out.get("basket_leg_materialization_path") is None:
        if final_status == "pending_entry":
            out["basket_leg_materialization_path"] = "maker_pending"
        elif final_status == "fallback_filled":
            fallback_reason = str(out.get("fallback_reason") or "")
            out["basket_leg_materialization_path"] = "ttl_market_fallback" if fallback_reason == "ttl_cancel_then_market_fallback" else "immediate_market_fallback"
        elif final_status in {"live_open", "closed", "partially_filled"}:
            out["basket_leg_materialization_path"] = "maker_filled"
        elif final_status in {"stale_abandoned", "basket_blocked_abandoned", "ttl_abandoned", "cancelled_unfilled"}:
            out["basket_leg_materialization_path"] = "abandoned"
    if out.get("basket_leg_comparable") is None:
        out["basket_leg_comparable"] = bool(out.get("basket_leg_materialized", False))
    if out.get("basket_incomplete_reason") is None and not bool(out.get("basket_leg_materialized", False)):
        if final_status == "stale_abandoned":
            out["basket_incomplete_reason"] = "signal_stale_before_materialization"
        elif final_status == "basket_blocked_abandoned":
            out["basket_incomplete_reason"] = "basket_blocked_before_materialization"
        elif final_status == "ttl_abandoned":
            out["basket_incomplete_reason"] = "ttl_expired_without_market_fill"
        elif final_status == "cancelled_unfilled":
            out["basket_incomplete_reason"] = "cancelled_without_fill"
        else:
            out["basket_incomplete_reason"] = "target_leg_not_materialized"
    out["final_entry_status"] = final_status or None
    return out



def apply_basket_metadata(rows: list[dict[str, Any]], meta_index: dict[str, dict[str, Any]]) -> list[dict[str, Any]]:
    by_trace_id = meta_index.get("by_trace_id", {})
    by_intention_id = meta_index.get("by_intention_id", {})
    by_signal_id = meta_index.get("by_signal_id", {})
    by_symbol_side = meta_index.get("by_symbol_side", {})
    out: list[dict[str, Any]] = []
    for row in rows:
        if not isinstance(row, dict):
            continue
        enriched = dict(row)
        trace_id = str(enriched.get("trace_id") or "").strip()
        intention_id = str(enriched.get("intention_id") or "").strip()
        signal_id = str(enriched.get("signal_id") or "").strip()
        symbol = str(enriched.get("symbol") or "").upper().strip()
        side = str(enriched.get("side") or "").strip()
        if signal_id and not intention_id:
            intention_id = signal_id
            enriched["intention_id"] = signal_id
        meta = (
            by_intention_id.get(intention_id)
            or by_signal_id.get(signal_id)
            or by_trace_id.get(trace_id)
            or by_symbol_side.get(f"{symbol}|{side}")
            or {}
        )
        if meta.get("basket_id") and (not enriched.get("basket_id") or signal_id or intention_id):
            enriched["basket_id"] = meta.get("basket_id")
        if meta.get("basket_role") and (not enriched.get("basket_role") or signal_id or intention_id):
            enriched["basket_role"] = meta.get("basket_role")
        if meta.get("planned_exit_ts") and not enriched.get("planned_exit_ts"):
            enriched["planned_exit_ts"] = meta.get("planned_exit_ts")
        if meta.get("target_notional_usdt") is not None and enriched.get("target_notional_usdt") is None and enriched.get("planned_notional") is None:
            enriched["target_notional_usdt"] = meta.get("target_notional_usdt")
        if meta.get("signal_price") is not None and enriched.get("signal_price") is None:
            enriched["signal_price"] = meta.get("signal_price")
        if meta.get("decision_ts") and not enriched.get("decision_ts") and not enriched.get("signal_timestamp"):
            enriched["decision_ts"] = meta.get("decision_ts")
        out.append(sanitize_rank213_row(enriched))
    return out



def reconstruct_order_history(*, pending_entries: list[dict[str, Any]], live_positions: list[dict[str, Any]], closed_trades: list[dict[str, Any]]) -> list[dict[str, Any]]:
    rows: list[dict[str, Any]] = []
    for pending in pending_entries:
        if not isinstance(pending, dict):
            continue
        rows.append({
            "timestamp": pending.get("entry_submit_at") or pending.get("signal_timestamp"),
            "basket_id": pending.get("basket_id"),
            "intention_id": pending.get("intention_id"),
            "trace_id": pending.get("trace_id"),
            "symbol": pending.get("symbol"),
            "side": phase6_mod.signal_to_order_side(str(pending.get("side") or "")),
            "order_role": "entry",
            "order_type": "LIMIT" if pending.get("entry_expires_at") else "MARKET",
            "price": pending.get("signal_price"),
            "qty": pending.get("planned_qty"),
            "status": "PENDING_RECONSTRUCTED",
            "exchange_order_id": pending.get("entry_order_id"),
            "client_order_id": pending.get("entry_client_order_id"),
            "lineage": "reconstructed_from_pending_entry",
        })
    for live in live_positions:
        if not isinstance(live, dict):
            continue
        rows.append({
            "timestamp": live.get("entry_time") or live.get("signal_timestamp"),
            "basket_id": live.get("basket_id"),
            "intention_id": live.get("intention_id"),
            "trace_id": live.get("trace_id"),
            "symbol": live.get("symbol"),
            "side": phase6_mod.signal_to_order_side(str(live.get("side") or "")),
            "order_role": "entry",
            "order_type": "MARKET",
            "price": live.get("entry_price"),
            "qty": live.get("entry_qty"),
            "status": "FILLED_RECONSTRUCTED",
            "exchange_order_id": live.get("entry_order_id"),
            "client_order_id": live.get("entry_client_order_id"),
            "lineage": "reconstructed_from_live_position",
        })
    for closed in closed_trades:
        if not isinstance(closed, dict):
            continue
        entry_side = phase6_mod.signal_to_order_side(str(closed.get("side") or ""))
        exit_side = phase6_mod.exit_order_side(str(closed.get("side") or ""))
        rows.append({
            "timestamp": closed.get("entry_time") or closed.get("signal_timestamp"),
            "basket_id": closed.get("basket_id"),
            "intention_id": closed.get("intention_id"),
            "trace_id": closed.get("trace_id"),
            "symbol": closed.get("symbol"),
            "side": entry_side,
            "order_role": "entry",
            "order_type": "MARKET",
            "price": closed.get("entry_price"),
            "qty": closed.get("qty"),
            "status": "FILLED_RECONSTRUCTED",
            "exchange_order_id": closed.get("entry_order_id"),
            "client_order_id": closed.get("entry_client_order_id"),
            "lineage": "reconstructed_from_closed_trade_entry",
        })
        exit_order_id = closed.get("timeout_exit_order_id") or closed.get("tp_order_id") or closed.get("sl_order_id")
        rows.append({
            "timestamp": closed.get("exit_time"),
            "basket_id": closed.get("basket_id"),
            "intention_id": closed.get("intention_id"),
            "trace_id": closed.get("trace_id"),
            "symbol": closed.get("symbol"),
            "side": exit_side,
            "order_role": "close",
            "order_type": "MARKET",
            "price": closed.get("exit_price"),
            "qty": closed.get("qty"),
            "status": str(closed.get("exit_reason") or "CLOSED").upper(),
            "exchange_order_id": exit_order_id,
            "client_order_id": closed.get("timeout_exit_client_order_id"),
            "lineage": "reconstructed_from_closed_trade_exit",
            "notes": {
                "exit_reason": closed.get("exit_reason"),
            },
        })
    deduped: list[dict[str, Any]] = []
    seen: set[tuple[Any, ...]] = set()
    for row in rows:
        key = (
            row.get("timestamp"),
            row.get("basket_id"),
            row.get("trace_id"),
            row.get("symbol"),
            row.get("order_role"),
            row.get("exchange_order_id"),
        )
        if key in seen:
            continue
        seen.add(key)
        deduped.append(row)
    return deduped[-400:]


def choose_tracked_basket_id(*, current_basket_id: str | None, pending_entries: list[dict[str, Any]], live_positions: list[dict[str, Any]], closed_trades: list[dict[str, Any]], leg_failures: list[dict[str, Any]]) -> str | None:
    basket_rows: dict[str, list[dict[str, Any]]] = {}
    for row in [*pending_entries, *live_positions, *closed_trades, *leg_failures]:
        if not isinstance(row, dict):
            continue
        basket_id = str(row.get("basket_id") or "").strip()
        if not basket_id:
            continue
        basket_rows.setdefault(basket_id, []).append(row)
    if current_basket_id and basket_rows.get(current_basket_id):
        return current_basket_id
    ranked: list[tuple[pd.Timestamp, str]] = []
    for basket_id, rows in basket_rows.items():
        latest_ts = pd.Timestamp.min.tz_localize("UTC")
        for row in rows:
            for field in ("exit_time", "entry_time", "decision_ts", "signal_timestamp", "planned_exit_ts"):
                ts = dryrun_mod.parse_ts(row.get(field))
                if ts is not None and ts > latest_ts:
                    latest_ts = ts
        ranked.append((latest_ts, basket_id))
    if not ranked:
        return current_basket_id
    ranked.sort()
    return ranked[-1][1]



def build_basket_entry_window_context(*, decision_ts: Any, now_ts: pd.Timestamp | None, cfg: dict[str, Any]) -> dict[str, Any]:
    execution = cfg.get("execution", {}) if isinstance(cfg.get("execution"), dict) else {}
    start_after = int(execution.get("official_entry_start_seconds_after_close", execution.get("entry_trigger_second", 5)))
    end_after = int(execution.get("official_entry_end_seconds_after_close", max(start_after, int(float(execution.get("max_signal_age_minutes", 3)) * 60) - 1)))
    decision_ts_parsed = dryrun_mod.parse_ts(decision_ts)
    if decision_ts_parsed is None:
        return {
            "eligible": False,
            "reason": "basket_decision_ts_missing",
            "detail": {
                "decision_ts": decision_ts,
            },
        }
    ref_ts = now_ts if now_ts is not None else dryrun_mod.parse_ts(dryrun_mod.iso_z(dryrun_mod.utc_now()))
    if ref_ts is None:
        ref_ts = decision_ts_parsed
    age_seconds = max(0.0, (ref_ts - decision_ts_parsed).total_seconds())
    window_start_ts = decision_ts_parsed + pd.Timedelta(seconds=start_after)
    window_end_ts = decision_ts_parsed + pd.Timedelta(seconds=end_after)
    if age_seconds < start_after:
        reason = "before_entry_window"
        eligible = False
    elif age_seconds > end_after:
        reason = "entry_window_closed"
        eligible = False
    else:
        reason = "within_entry_window"
        eligible = True
    return {
        "eligible": eligible,
        "reason": reason,
        "detail": {
            "bar_key": dryrun_mod.iso_z(decision_ts_parsed),
            "decision_ts": dryrun_mod.iso_z(decision_ts_parsed),
            "seconds_since_decision": round(age_seconds, 3),
            "window_start_seconds": start_after,
            "window_end_seconds": end_after,
            "window_start_ts": dryrun_mod.iso_z(window_start_ts),
            "window_end_ts": dryrun_mod.iso_z(window_end_ts),
        },
    }



def build_parity_current_for_basket(*, basket_id: str | None, shadow_current: dict[str, Any], intentions: list[dict[str, Any]]) -> tuple[dict[str, Any] | None, list[dict[str, Any]]]:
    if not basket_id:
        return None, []
    basket_intentions = [
        dict(row) for row in intentions
        if isinstance(row, dict) and str(row.get("basket_id") or "").strip() == basket_id
    ]
    current_basket_id = dryrun_mod.derive_basket_id(shadow_current)
    if basket_id == current_basket_id:
        current_payload = dict(shadow_current)
    elif basket_intentions:
        decision_ts = basket_intentions[0].get("decision_ts")
        longs = [str(row.get("symbol") or "").upper() for row in basket_intentions if str(row.get("side") or "") == "long" and row.get("symbol")]
        shorts = [str(row.get("symbol") or "").upper() for row in basket_intentions if str(row.get("side") or "") == "short" and row.get("symbol")]
        current_payload = {
            "bar_key": decision_ts,
            "decision_ts": decision_ts,
            "planned_exit_ts": basket_intentions[0].get("planned_exit_ts"),
            "decision": "historical_live_basket",
            "gate_on": True,
            "is_preview": False,
            "longs": longs,
            "shorts": shorts,
        }
    else:
        current_payload = None
    return current_payload, basket_intentions



def derive_submit_stats_for_basket(*, basket_id: str | None, intentions: list[dict[str, Any]], pending_entries: list[dict[str, Any]], live_positions: list[dict[str, Any]], closed_trades: list[dict[str, Any]], orders: list[dict[str, Any]], leg_failures: list[dict[str, Any]]) -> dict[str, Any]:
    if not basket_id:
        return {
            "legs_attempted": 0,
            "legs_submitted": 0,
            "legs_submit_failed": 0,
            "legs_failed_post_only": 0,
            "legs_materialized": 0,
            "legs_unmaterialized": 0,
            "materialized_symbol_count": 0,
            "materialized_symbols": [],
            "unmaterialized_symbols": [],
            "basket_comparable": False,
        }
    intended_symbols = {
        str(row.get("symbol") or "").upper()
        for row in intentions
        if isinstance(row, dict) and str(row.get("basket_id") or "") == str(basket_id) and row.get("symbol")
    }
    intended_count = len(intended_symbols)
    submitted_symbols = {
        str(row.get("symbol") or "").upper()
        for row in [*pending_entries, *live_positions, *closed_trades]
        if isinstance(row, dict) and str(row.get("basket_id") or "") == str(basket_id) and row.get("symbol")
    }
    materialized_symbols = {
        str(row.get("symbol") or "").upper()
        for row in [*pending_entries, *live_positions, *closed_trades]
        if isinstance(row, dict)
        and str(row.get("basket_id") or "") == str(basket_id)
        and row.get("symbol")
        and bool(row.get("basket_leg_materialized", True))
    }
    fallback_orders = [
        row for row in orders
        if isinstance(row, dict)
        and str(row.get("basket_id") or "") == str(basket_id)
        and str(row.get("order_role") or "") == "entry_fallback"
    ]
    rejected_post_only_symbols = {
        str(row.get("symbol") or "").upper()
        for row in orders
        if isinstance(row, dict)
        and str(row.get("basket_id") or "") == str(basket_id)
        and str(row.get("order_role") or "") == "entry_rejected_post_only"
        and row.get("symbol")
    }
    abandoned_symbols = {
        str(row.get("symbol") or "").upper()
        for row in orders
        if isinstance(row, dict)
        and str(row.get("basket_id") or "") == str(basket_id)
        and str(row.get("order_role") or "") == "entry_abandoned"
        and row.get("symbol")
    }
    basket_failures = [
        row for row in leg_failures
        if isinstance(row, dict) and str(row.get("basket_id") or "") == str(basket_id)
    ]
    failed_symbols = ((intended_symbols - submitted_symbols) | abandoned_symbols) if intended_count > 0 else set()
    if failed_symbols:
        explicit_failure_symbols = {
            str(row.get("symbol") or "").upper()
            for row in basket_failures
            if isinstance(row, dict) and row.get("symbol")
        }
        for symbol in sorted(failed_symbols - explicit_failure_symbols):
            basket_failures.append({"reason": "submit_failed", "symbol": symbol})
    unmaterialized_symbols = sorted((intended_symbols - materialized_symbols) | abandoned_symbols)
    legs_failed_post_only = sum(1 for row in basket_failures if str(row.get("reason") or "") == "maker_rejected_post_only")
    return {
        "legs_attempted": intended_count,
        "legs_submitted": len(submitted_symbols),
        "legs_submit_failed": len(failed_symbols),
        "legs_failed_post_only": max(legs_failed_post_only, len(fallback_orders), len(rejected_post_only_symbols)),
        "legs_materialized": len(materialized_symbols),
        "legs_unmaterialized": len(unmaterialized_symbols),
        "materialized_symbol_count": len(materialized_symbols),
        "materialized_symbols": sorted(materialized_symbols),
        "unmaterialized_symbols": unmaterialized_symbols,
        "basket_comparable": bool(intended_count > 0 and len(unmaterialized_symbols) == 0),
    }



def collect_exchange_open_positions(*, bridge: Any, cfg: dict[str, Any]) -> list[dict[str, Any]]:
    try:
        positions_payload = bridge.get_binance_perp_positions()
    except Exception:
        return []
    enabled = {str(symbol).upper() for symbol in cfg.get("universe", {}).get("symbols", []) if symbol}
    rows = phase6_mod.extract_exchange_open_positions(positions_payload)
    out: list[dict[str, Any]] = []
    for row in rows:
        symbol = str(row.get("symbol") or "").upper()
        if symbol not in enabled:
            continue
        out.append({
            "symbol": symbol,
            "side": row.get("side"),
            "qty": row.get("qty"),
            "position_side": row.get("position_side"),
            "entry_price": row.get("entry_price"),
            "unrealized_pnl": row.get("unrealized_pnl"),
        })
    return out


def rank213_manage_pending_entries(*, bridge: Any, cfg: dict[str, Any], phase6_state: Any, run_ctx: Any, event_bus: Any, events_written: list[dict[str, Any]], orders_out: list[dict[str, Any]], emitted_orders: list[dict[str, Any]], warnings_out: list[dict[str, Any]], exchange_reconciliation: dict[str, Any] | None = None) -> tuple[int, int]:
    phase6 = cfg["phase6"]
    current_config_version = phase6_mod.config_hash(cfg)
    current_code_version = phase6_mod.code_version()
    query_retry_attempts = int(phase6.get("query_retry_attempts", 3))
    query_retry_sleep = float(phase6.get("query_retry_sleep_seconds", 0.5))
    entry_policy = _resolve_entry_policy(cfg, phase6)
    pending_manager_cfg = phase6.get("pending_manager", {}) if isinstance(phase6.get("pending_manager"), dict) else {}
    fallback_to_market = bool(entry_policy.get("fallback_to_market_on_ttl", True))
    ttl_detection_sla_seconds = float(pending_manager_cfg.get("ttl_detection_sla_seconds", 10.0))
    target_leverage = max(1, int(phase6_mod.safe_float(phase6.get("default_leverage", 1), 1)))
    execution_cfg = cfg.get("execution", {}) if isinstance(cfg.get("execution"), dict) else {}
    max_entry_age_minutes = float(execution_cfg.get("max_signal_age_minutes", phase6.get("safety", {}).get("max_signal_age_minutes", 3)))
    exchange_reconciliation = exchange_reconciliation or {}

    moved_to_live = 0
    managed = 0
    keep_pending: list[dict[str, Any]] = []

    for pending in phase6_state.pending_entries:
        managed += 1
        trace_id = str(pending.get("trace_id") or phase6_mod.make_trace_id(str(pending.get("signal_id") or "rank213-pending")))
        symbol = str(pending.get("symbol"))
        side = str(pending.get("side"))
        entry_order_id = pending.get("entry_order_id")
        entry_client_order_id = pending.get("entry_client_order_id")

        try:
            snap = phase6_mod.query_order_with_retry(
                bridge,
                symbol=symbol,
                order_id=entry_order_id,
                client_order_id=entry_client_order_id,
                attempts=query_retry_attempts,
                sleep_seconds=query_retry_sleep,
            )
        except Exception as exc:
            phase6_mod.append_warning(warnings_out, trace_id=trace_id, symbol=symbol, message="entry order query failed", payload={"error": str(exc)})
            keep_pending.append(pending)
            continue

        status = str(snap.get("status") or "").upper()
        executed_qty = phase6_mod.safe_float(snap.get("executedQty"))
        avg_price = phase6_mod.safe_float(snap.get("avgPrice"), phase6_mod.safe_float(snap.get("price"), phase6_mod.safe_float(pending.get("signal_price"))))
        signal_ts = phase6_mod.parse_utc(str(pending.get("signal_timestamp") or ""))
        expire_at = phase6_mod.parse_utc(str(pending.get("entry_expires_at") or ""))
        entry_age_seconds = None
        if signal_ts is not None:
            entry_age_seconds = max(0.0, (run_ctx.now_dt - signal_ts).total_seconds())
        ttl_age_seconds = None
        if signal_ts is not None and expire_at is not None:
            ttl_age_seconds = max(0.0, (expire_at - signal_ts).total_seconds())
        entry_age_too_old = entry_age_seconds is not None and entry_age_seconds > max(0.0, max_entry_age_minutes * 60.0)
        ttl_already_expired = expire_at is not None and run_ctx.now_dt >= expire_at
        ttl_effective_dt = expire_at if expire_at is not None else run_ctx.now_dt
        ttl_expired_at_effective = str(pending.get("ttl_expired_at_effective") or pending.get("ttl_expired_at") or "") or None
        ttl_detected_at = str(pending.get("ttl_detected_at") or "") or None
        ttl_detection_lag_seconds_value = pending.get("ttl_detection_lag_seconds")
        ttl_detection_lag_seconds = phase6_mod.safe_float(ttl_detection_lag_seconds_value, math.nan)
        if math.isnan(ttl_detection_lag_seconds):
            ttl_detection_lag_seconds = None
        ttl_manager_over_sla = bool(pending.get("ttl_manager_over_sla", False))
        ttl_expired_at = pending.get("ttl_expired_at")
        cancel_requested_at = pending.get("cancel_requested_at")
        cancel_confirmed_at = pending.get("cancel_confirmed_at")
        signal_age_seconds_at_ttl = pending.get("signal_age_seconds_at_ttl")
        basket_safety_classification_at_ttl = pending.get("basket_safety_classification_at_ttl")
        fallback_decision = pending.get("fallback_decision")
        fallback_cid = None
        fallback_executed_qty = phase6_mod.safe_float(pending.get("fallback_fill_qty"), 0.0)
        fallback_avg_price = phase6_mod.safe_float(pending.get("fallback_fill_price"), math.nan)
        orders_out.append({
            "timestamp": run_ctx.now_iso,
            "basket_id": pending.get("basket_id"),
            "intention_id": pending.get("intention_id"),
            "trace_id": trace_id,
            "symbol": symbol,
            "side": snap.get("side"),
            "order_role": "entry",
            "order_type": snap.get("type"),
            "price": snap.get("price"),
            "qty": snap.get("origQty"),
            "status": snap.get("status"),
            "exchange_order_id": snap.get("orderId"),
            "client_order_id": snap.get("clientOrderId"),
            "lineage": "pending_entry_snapshot",
            "notes": {
                "executed_qty": executed_qty,
                "entry_fallback_used": bool(pending.get("entry_fallback_used", False)),
                "entry_rejected_post_only": bool(pending.get("entry_rejected_post_only", False)),
            },
        })

        is_filled = status == "FILLED" or (executed_qty > 0 and status in {"PARTIALLY_FILLED", "FILLED"})
        signal_age_seconds_at_check = entry_age_seconds
        if entry_age_too_old and not is_filled and not ttl_already_expired:
            try:
                bridge.cancel_binance_perp_order(symbol=symbol, order_id=entry_order_id, client_order_id=entry_client_order_id)
            except Exception:
                pass
            phase6_mod.append_warning(
                warnings_out,
                trace_id=trace_id,
                symbol=symbol,
                message="entry age exceeded rank213 decision validity window",
                payload={
                    "signal_timestamp": pending.get("signal_timestamp"),
                    "entry_age_seconds": round(float(entry_age_seconds or 0.0), 3),
                    "max_entry_age_minutes": max_entry_age_minutes,
                    "status": status,
                    "executed_qty": executed_qty,
                },
            )
            phase6_mod.append_event(
                event_bus,
                events_written,
                phase6_mod.EventRecord(
                    timestamp=run_ctx.now_iso,
                    event_type=phase6_mod.EventType.ORDER_CANCELLED,
                    symbol=symbol,
                    side=side,
                    trace_id=trace_id,
                    message="rank213 pending entry canceled because signal aged out before valid fill",
                    payload={
                        "signal_timestamp": pending.get("signal_timestamp"),
                        "entry_age_seconds": round(float(entry_age_seconds or 0.0), 3),
                        "max_entry_age_minutes": max_entry_age_minutes,
                        "status": status,
                        "executed_qty": executed_qty,
                    },
                ),
            )
            continue
        if not is_filled:
            if ttl_already_expired:
                if ttl_expired_at_effective is None and expire_at is not None:
                    ttl_expired_at_effective = expire_at.strftime("%Y-%m-%dT%H:%M:%SZ")
                if ttl_detected_at is None:
                    ttl_detected_at = run_ctx.now_iso
                if ttl_detection_lag_seconds is None:
                    ttl_detection_lag_seconds = max(0.0, (run_ctx.now_dt - ttl_effective_dt).total_seconds())
                ttl_manager_over_sla = ttl_detection_lag_seconds > ttl_detection_sla_seconds
                ttl_expired_at = ttl_detected_at
                cancel_requested_at = ttl_detected_at
                if ttl_manager_over_sla:
                    phase6_mod.append_warning(
                        warnings_out,
                        trace_id=trace_id,
                        symbol=symbol,
                        message="pending ttl manager detected expiry after sla",
                        payload={
                            "ttl_expired_at_effective": ttl_expired_at_effective,
                            "ttl_detected_at": ttl_detected_at,
                            "ttl_detection_lag_seconds": ttl_detection_lag_seconds,
                            "ttl_detection_sla_seconds": ttl_detection_sla_seconds,
                        },
                    )
                phase6_mod.cancel_order_quietly(
                    bridge,
                    symbol=symbol,
                    order_id=entry_order_id,
                    client_order_id=entry_client_order_id,
                )
                cancel_confirmed_at = run_ctx.now_iso
                try:
                    snap = phase6_mod.query_order_with_retry(
                        bridge,
                        symbol=symbol,
                        order_id=entry_order_id,
                        client_order_id=entry_client_order_id,
                        attempts=query_retry_attempts,
                        sleep_seconds=query_retry_sleep,
                    )
                except Exception as exc:
                    phase6_mod.append_warning(warnings_out, trace_id=trace_id, symbol=symbol, message="entry order requery after ttl cancel failed", payload={"error": str(exc)})
                status = str(snap.get("status") or status or "").upper()
                executed_qty = phase6_mod.safe_float(snap.get("executedQty"), executed_qty)
                avg_price = phase6_mod.safe_float(snap.get("avgPrice"), phase6_mod.safe_float(snap.get("price"), avg_price))
                remaining_qty = max(0.0, phase6_mod.safe_float(pending.get("planned_qty")) - executed_qty)
                signal_age_seconds_at_ttl = ttl_age_seconds if ttl_age_seconds is not None else max(0.0, (ttl_effective_dt - signal_ts).total_seconds()) if signal_ts is not None else signal_age_seconds_at_check
                ttl_fallback_blockers, ttl_fallback_scope = _ttl_fallback_blockers_for_basket(
                    exchange_reconciliation=exchange_reconciliation,
                    basket_id=str(pending.get("basket_id") or "") or None,
                )
                basket_safety_classification_at_ttl = "blocked" if ttl_fallback_blockers else "healthy"
                fallback_decision = None
                should_fallback_to_market = (
                    fallback_to_market
                    and remaining_qty > 0
                    and signal_age_seconds_at_ttl is not None
                    and signal_age_seconds_at_ttl <= max(0.0, max_entry_age_minutes * 60.0)
                    and basket_safety_classification_at_ttl == "healthy"
                )
                if should_fallback_to_market:
                    leverage_guard = phase6_mod.ensure_binance_leverage(
                        bridge,
                        symbol=symbol,
                        signal_side=side,
                        target_leverage=target_leverage,
                    )
                    phase6_mod.append_event(
                        event_bus,
                        events_written,
                        phase6_mod.EventRecord(
                            timestamp=run_ctx.now_iso,
                            event_type=phase6_mod.EventType.ORDER_STATUS_SYNC,
                            symbol=symbol,
                            side=side,
                            trace_id=trace_id,
                            message="rank213 leverage enforced before fallback market entry",
                            payload=leverage_guard,
                        ),
                    )
                    fallback_cid = phase6_mod.make_client_order_id("fb", symbol, run_ctx, trace_id)
                    try:
                        market_entry = bridge.place_binance_perp_live_market_order(
                            symbol=symbol,
                            side=phase6_mod.signal_to_order_side(side),
                            quantity=remaining_qty,
                            reduce_only=None,
                            position_side=phase6_mod.hedge_position_side(side),
                            client_order_id=fallback_cid,
                        )
                    except Exception as fallback_exc:
                        fallback_text = str(fallback_exc)
                        phase6_mod.append_warning(
                            warnings_out,
                            trace_id=trace_id,
                            symbol=symbol,
                            message="ttl fallback market order failed",
                            payload={
                                "error": fallback_text,
                                "remaining_qty": remaining_qty,
                                "ttl_expired_at": ttl_expired_at,
                                "ttl_expired_at_effective": ttl_expired_at_effective,
                                "ttl_detected_at": ttl_detected_at,
                                "ttl_detection_lag_seconds": ttl_detection_lag_seconds,
                                "ttl_manager_over_sla": ttl_manager_over_sla,
                                "cancel_requested_at": cancel_requested_at,
                                "cancel_confirmed_at": cancel_confirmed_at,
                                "signal_age_seconds_at_ttl": signal_age_seconds_at_ttl,
                                "basket_safety_classification_at_ttl": basket_safety_classification_at_ttl,
                                "ttl_fallback_blockers": ttl_fallback_blockers,
                                "ttl_fallback_scope": ttl_fallback_scope,
                            },
                        )
                        market_entry = None
                    market_entry_n = phase6_mod.normalize_order_payload(market_entry, source="rank213_entry_fallback_market") if market_entry is not None else {}
                    fallback_executed_qty = phase6_mod.safe_float(market_entry_n.get("executed_qty"), 0.0)
                    fallback_avg_price = phase6_mod.safe_float(market_entry_n.get("avg_price"), phase6_mod.safe_float(market_entry_n.get("price"), avg_price))
                    if fallback_executed_qty > 0:
                        executed_qty = executed_qty + fallback_executed_qty
                        avg_price = fallback_avg_price
                        fallback_decision = "ttl_cancel_then_market_fallback"
                        fallback_order_row = {
                            "timestamp": run_ctx.now_iso,
                            "basket_id": pending.get("basket_id"),
                            "intention_id": pending.get("intention_id"),
                            "trace_id": trace_id,
                            "symbol": symbol,
                            "side": phase6_mod.signal_to_order_side(side),
                            "order_role": "entry_fallback",
                            "order_type": "MARKET",
                            "price": market_entry_n.get("avg_price") or market_entry_n.get("price"),
                            "qty": market_entry_n.get("executed_qty") or market_entry_n.get("orig_qty"),
                            "status": market_entry_n.get("status"),
                            "exchange_order_id": market_entry_n.get("order_id"),
                            "client_order_id": market_entry_n.get("client_order_id"),
                            "lineage": "ttl_cancel_then_market_fallback",
                            "notes": {
                                "expired_entry_order_id": entry_order_id,
                                "expired_entry_client_order_id": entry_client_order_id,
                                "remaining_qty_before_fallback": remaining_qty,
                                "ttl_expired_at": ttl_expired_at,
                                "cancel_requested_at": cancel_requested_at,
                                "cancel_confirmed_at": cancel_confirmed_at,
                                "snapshot_executed_qty_before_cancel": phase6_mod.safe_float(snap.get("executedQty")),
                                "remaining_qty_after_cancel": remaining_qty,
                                "signal_age_seconds_at_ttl": signal_age_seconds_at_ttl,
                                "basket_safety_classification_at_ttl": basket_safety_classification_at_ttl,
                                "ttl_fallback_blockers": ttl_fallback_blockers,
                                "ttl_fallback_scope": ttl_fallback_scope,
                                "fallback_reason": "ttl_cancel_then_market_fallback",
                                "fallback_decision": "ttl_cancel_then_market_fallback",
                            },
                        }
                        orders_out.append(fallback_order_row)
                        emitted_orders.append(fallback_order_row)
                    is_filled = executed_qty > 0
                if not is_filled:
                    abandon_order_row = {
                        "timestamp": run_ctx.now_iso,
                        "basket_id": pending.get("basket_id"),
                        "intention_id": pending.get("intention_id"),
                        "trace_id": trace_id,
                        "symbol": symbol,
                        "side": phase6_mod.signal_to_order_side(side),
                        "order_role": "entry_abandoned",
                        "order_type": "MARKET",
                        "price": None,
                        "qty": remaining_qty,
                        "status": "ABANDONED",
                        "exchange_order_id": None,
                        "client_order_id": fallback_cid if should_fallback_to_market else None,
                        "lineage": "ttl_cancel_without_materialization",
                    }
                    abandon_reason = "abandon_after_ttl"
                    if signal_age_seconds_at_ttl is None or signal_age_seconds_at_ttl > max(0.0, max_entry_age_minutes * 60.0):
                        abandon_reason = "abandon_signal_stale"
                    elif basket_safety_classification_at_ttl != "healthy":
                        abandon_reason = "abandon_basket_blocked"
                    fallback_decision = abandon_reason
                    phase6_mod.append_warning(
                        warnings_out,
                        trace_id=trace_id,
                        symbol=symbol,
                        message="entry expired without fill",
                        payload={
                            "order_id": entry_order_id,
                            "status": status,
                            "ttl_expired_at": ttl_expired_at,
                            "cancel_requested_at": cancel_requested_at,
                            "cancel_confirmed_at": cancel_confirmed_at,
                            "snapshot_executed_qty_before_cancel": phase6_mod.safe_float(snap.get("executedQty")),
                            "remaining_qty_after_cancel": remaining_qty,
                            "signal_age_seconds_at_ttl": signal_age_seconds_at_ttl,
                            "basket_safety_classification_at_ttl": basket_safety_classification_at_ttl,
                            "ttl_fallback_blockers": ttl_fallback_blockers,
                            "ttl_fallback_scope": ttl_fallback_scope,
                            "fallback_decision": abandon_reason,
                        },
                    )
                    phase6_mod.append_event(
                        event_bus,
                        events_written,
                        phase6_mod.EventRecord(
                            timestamp=run_ctx.now_iso,
                            event_type=phase6_mod.EventType.ORDER_CANCELLED,
                            symbol=symbol,
                            side=side,
                            trace_id=trace_id,
                            message="rank213 pending entry expired and canceled",
                            payload={
                                "order_id": entry_order_id,
                                "status": status,
                                "ttl_expired_at": ttl_expired_at,
                                "cancel_requested_at": cancel_requested_at,
                                "cancel_confirmed_at": cancel_confirmed_at,
                                "snapshot_executed_qty_before_cancel": phase6_mod.safe_float(snap.get("executedQty")),
                                "remaining_qty_after_cancel": remaining_qty,
                                "signal_age_seconds_at_ttl": signal_age_seconds_at_ttl,
                                "basket_safety_classification_at_ttl": basket_safety_classification_at_ttl,
                                "ttl_fallback_scope": ttl_fallback_scope,
                                "fallback_decision": abandon_reason,
                            },
                        ),
                    )
                    orders_out.append(abandon_order_row)
                    emitted_orders.append(abandon_order_row)
                    continue
            else:
                keep_pending.append(pending)
                continue

        if executed_qty <= 0:
            pending_after_check = compute_entry_outcome_fields(row={
                **pending,
                "snapshot_executed_qty_before_cancel": phase6_mod.safe_float(snap.get("executedQty"), executed_qty),
                "remaining_qty_after_cancel": max(0.0, phase6_mod.safe_float(pending.get("planned_qty")) - executed_qty),
                "ttl_expired_at": ttl_detected_at if ttl_already_expired else pending.get("ttl_expired_at"),
                "ttl_expired_at_effective": ttl_expired_at_effective if ttl_already_expired else pending.get("ttl_expired_at_effective"),
                "ttl_detected_at": ttl_detected_at if ttl_already_expired else pending.get("ttl_detected_at"),
                "ttl_detection_lag_seconds": ttl_detection_lag_seconds if ttl_already_expired else pending.get("ttl_detection_lag_seconds"),
                "ttl_manager_over_sla": ttl_manager_over_sla if ttl_already_expired else pending.get("ttl_manager_over_sla"),
                "cancel_requested_at": (cancel_requested_at if ttl_already_expired else pending.get("cancel_requested_at")),
                "cancel_confirmed_at": (cancel_confirmed_at if ttl_already_expired else pending.get("cancel_confirmed_at")),
                "signal_age_seconds_at_ttl": signal_age_seconds_at_ttl if ttl_already_expired else pending.get("signal_age_seconds_at_ttl"),
                "basket_safety_classification_at_ttl": basket_safety_classification_at_ttl if ttl_already_expired else pending.get("basket_safety_classification_at_ttl"),
                "fallback_decision": fallback_decision,
                "final_entry_qty": executed_qty,
            }, now_iso=run_ctx.now_iso)
            if fallback_decision in {"abandon_after_ttl", "abandon_signal_stale", "abandon_basket_blocked"}:
                continue
            keep_pending.append(pending_after_check)
            continue

        live_row = compute_entry_outcome_fields(row={
            "trace_id": trace_id,
            "signal_id": pending.get("signal_id"),
            "signal_timestamp": pending.get("signal_timestamp"),
            "signal_price": pending.get("signal_price"),
            "signal_confirmed_at": phase6_mod.signal_confirmed_at(
                str(pending.get("signal_timestamp") or ""),
                {"signal_confirmed_at_override": str(pending.get("signal_confirmed_at") or "") or None},
            ),
            "intention_id": pending.get("intention_id"),
            "symbol": symbol,
            "side": side,
            "code_version": pending.get("code_version") or current_code_version,
            "config_version": pending.get("config_version") or current_config_version,
            "entry_order_id": entry_order_id,
            "entry_client_order_id": entry_client_order_id,
            "entry_time": run_ctx.now_iso,
            "entry_submit_at": pending.get("entry_submit_at"),
            "entry_price": avg_price,
            "entry_qty": executed_qty,
            "entry_notional": executed_qty * avg_price,
            "entry_latency_seconds": round(float(entry_age_seconds or 0.0), 3),
            "basket_id": pending.get("basket_id"),
            "basket_role": pending.get("basket_role"),
            "planned_exit_ts": pending.get("planned_exit_ts"),
            "hold_bars": pending.get("hold_bars"),
            "horizon_bar_minutes": pending.get("horizon_bar_minutes"),
            "exit_policy": pending.get("exit_policy") or "rank213_horizon_market",
            "entry_policy_mode": pending.get("entry_policy_mode"),
            "entry_ttl_seconds": pending.get("entry_ttl_seconds"),
            "entry_ttl_source": pending.get("entry_ttl_source"),
            "post_only_reject_policy": pending.get("post_only_reject_policy"),
            "maker_attempt_count": pending.get("maker_attempt_count"),
            "maker_price_quantized": pending.get("maker_price_quantized"),
            "maker_submit_price": pending.get("maker_submit_price"),
            "maker_price_adjusted_for_post_only_safety": pending.get("maker_price_adjusted_for_post_only_safety"),
            "maker_adjustment_ticks": pending.get("maker_adjustment_ticks"),
            "best_bid_at_submit": pending.get("best_bid_at_submit"),
            "best_ask_at_submit": pending.get("best_ask_at_submit"),
            "submit_outcome": pending.get("submit_outcome"),
            "fallback_reason": pending.get("fallback_reason"),
            "entry_expires_at": pending.get("entry_expires_at"),
            "ttl_expired_at": ttl_detected_at if ttl_already_expired else pending.get("ttl_expired_at"),
            "ttl_expired_at_effective": ttl_expired_at_effective if ttl_already_expired else pending.get("ttl_expired_at_effective"),
            "ttl_detected_at": ttl_detected_at if ttl_already_expired else pending.get("ttl_detected_at"),
            "ttl_detection_lag_seconds": ttl_detection_lag_seconds if ttl_already_expired else pending.get("ttl_detection_lag_seconds"),
            "ttl_manager_over_sla": ttl_manager_over_sla if ttl_already_expired else pending.get("ttl_manager_over_sla"),
            "cancel_requested_at": cancel_requested_at if ttl_already_expired else pending.get("cancel_requested_at"),
            "cancel_confirmed_at": cancel_confirmed_at if ttl_already_expired else pending.get("cancel_confirmed_at"),
            "snapshot_executed_qty_before_cancel": phase6_mod.safe_float(snap.get("executedQty"), executed_qty) if ttl_already_expired else pending.get("snapshot_executed_qty_before_cancel"),
            "remaining_qty_after_cancel": max(0.0, phase6_mod.safe_float(pending.get("planned_qty")) - executed_qty) if ttl_already_expired else pending.get("remaining_qty_after_cancel"),
            "signal_age_seconds_at_ttl": signal_age_seconds_at_ttl if ttl_already_expired else pending.get("signal_age_seconds_at_ttl"),
            "basket_safety_classification_at_ttl": basket_safety_classification_at_ttl if ttl_already_expired else pending.get("basket_safety_classification_at_ttl"),
            "fallback_decision": fallback_decision,
            "fallback_submitted_at": run_ctx.now_iso if fallback_decision == "ttl_cancel_then_market_fallback" else pending.get("fallback_submitted_at"),
            "fallback_fill_qty": fallback_executed_qty if fallback_decision == "ttl_cancel_then_market_fallback" else pending.get("fallback_fill_qty"),
            "fallback_fill_price": fallback_avg_price if fallback_decision == "ttl_cancel_then_market_fallback" else pending.get("fallback_fill_price"),
            "final_entry_status": "fallback_filled" if fallback_decision == "ttl_cancel_then_market_fallback" else "live_open",
            "timeout_exit_order_id": None,
            "tp_order_id": None,
            "sl_order_id": None,
        }, now_iso=run_ctx.now_iso)
        phase6_state.live_positions.append(live_row)
        moved_to_live += 1
        phase6_mod.append_event(
            event_bus,
            events_written,
            phase6_mod.EventRecord(
                timestamp=run_ctx.now_iso,
                event_type=phase6_mod.EventType.POSITION_OPENED,
                symbol=symbol,
                side=side,
                trace_id=trace_id,
                message="rank213 entry filled and moved to horizon-managed live position",
                payload={
                    "entry_order_id": entry_order_id,
                    "entry_qty": executed_qty,
                    "entry_price": avg_price,
                    "planned_exit_ts": live_row.get("planned_exit_ts"),
                    "exit_policy": live_row.get("exit_policy"),
                },
            ),
        )

    phase6_state.pending_entries = keep_pending
    return managed, moved_to_live


def rank213_flatten_positions(*, bridge: Any, positions: list[dict[str, Any]], reason: str, run_at_utc: str, paths: dict[str, Path]) -> tuple[list[dict[str, Any]], list[dict[str, Any]], list[dict[str, Any]], list[dict[str, Any]], int]:
    if not positions:
        return [], [], [], [], 0
    run_ctx = phase6_mod.RunContext(now_iso=run_at_utc, now_dt=pd.to_datetime(run_at_utc, utc=True).to_pydatetime())
    event_bus = phase6_mod.JsonlEventBus(paths["events"])
    events_written: list[dict[str, Any]] = []
    orders_out: list[dict[str, Any]] = []
    warnings_out: list[dict[str, Any]] = []
    closed_out: list[dict[str, Any]] = []
    flattened = 0
    try:
        positions_payload = bridge.get_binance_perp_positions()
    except Exception as exc:
        phase6_mod.append_warning(warnings_out, trace_id=phase6_mod.make_trace_id("rank213-flatten"), symbol="ACCOUNT", message="rank213 flatten exchange positions query failed", payload={"error": str(exc), "reason": reason})
        return positions, orders_out, closed_out, warnings_out, flattened

    keep_positions: list[dict[str, Any]] = []
    for pos in positions:
        symbol = str(pos.get("symbol") or "")
        side = str(pos.get("side") or "")
        trace_id = str(pos.get("trace_id") or phase6_mod.make_trace_id(str(pos.get("signal_id") or "rank213-flatten")))
        exchange_qty = phase6_mod.exchange_open_qty_for_position(positions_payload, symbol=symbol, side=side)
        entry_price = phase6_mod.safe_float(pos.get("entry_price"))
        if exchange_qty <= 0:
            close_row = phase6_mod.close_position_record(pos=pos, exit_price=entry_price, exit_time_iso=run_at_utc, exit_reason=f"flatten_reconciled_{reason}")
            closed_out.append(close_row)
            flattened += 1
            phase6_mod.append_event(
                event_bus,
                events_written,
                phase6_mod.EventRecord(
                    timestamp=run_at_utc,
                    event_type=phase6_mod.EventType.POSITION_CLOSED,
                    symbol=symbol,
                    side=side,
                    trace_id=trace_id,
                    message="rank213 flatten reconciled already-flat exchange position",
                    payload={"reason": reason, "close_row": close_row, "exchange_qty": exchange_qty},
                ),
            )
            continue
        close_side = phase6_mod.exit_order_side(side)
        close_cid = phase6_mod.make_client_order_id("fl", symbol, run_ctx, trace_id)
        market_close = bridge.place_binance_perp_live_market_order(
            symbol=symbol,
            side=close_side,
            quantity=exchange_qty,
            reduce_only=None,
            position_side=phase6_mod.hedge_position_side(side),
            client_order_id=close_cid,
        )
        market_close_n = phase6_mod.normalize_order_payload(market_close, source="rank213_basket_flatten")
        flatten_order_row = {
            "timestamp": run_at_utc,
            "symbol": symbol,
            "side": close_side,
            "order_role": "basket_flatten",
            "order_type": "MARKET",
            "price": market_close_n.get("avg_price") or market_close_n.get("price"),
            "qty": market_close_n.get("executed_qty") or market_close_n.get("orig_qty"),
            "status": market_close_n.get("status"),
            "exchange_order_id": market_close_n.get("order_id"),
            "client_order_id": market_close_n.get("client_order_id"),
            "flatten_reason": reason,
        }
        orders_out.append(flatten_order_row)
        exit_price = phase6_mod.safe_float(market_close_n.get("avg_price"), phase6_mod.safe_float(market_close_n.get("price"), entry_price))
        close_row = phase6_mod.close_position_record(pos=pos, exit_price=exit_price, exit_time_iso=run_at_utc, exit_reason=f"basket_flatten_{reason}")
        closed_out.append(close_row)
        flattened += 1
        phase6_mod.append_event(
            event_bus,
            events_written,
            phase6_mod.EventRecord(
                timestamp=run_at_utc,
                event_type=phase6_mod.EventType.POSITION_CLOSED,
                symbol=symbol,
                side=side,
                trace_id=trace_id,
                message="rank213 basket flatten market close executed",
                payload={"reason": reason, "close_order": market_close_n, "close_row": close_row},
            ),
        )
    return keep_positions, orders_out, closed_out, warnings_out, flattened


def rank213_flatten_exchange_residuals(*, bridge: Any, exchange_positions: list[dict[str, Any]], reason: str, run_at_utc: str, paths: dict[str, Path]) -> tuple[list[dict[str, Any]], list[dict[str, Any]], int, list[dict[str, Any]]]:
    residual_rows = [
        row for row in exchange_positions
        if isinstance(row, dict)
        and bool(row.get("rank213_owned"))
        and str(row.get("reconciliation_classification") or "") in {"close_conflict_residual", "residual_open_on_exchange"}
    ]
    if not residual_rows:
        return [], [], 0, []
    run_ctx = phase6_mod.RunContext(now_iso=run_at_utc, now_dt=pd.to_datetime(run_at_utc, utc=True).to_pydatetime())
    event_bus = phase6_mod.JsonlEventBus(paths["events"])
    events_written: list[dict[str, Any]] = []
    orders_out: list[dict[str, Any]] = []
    warnings_out: list[dict[str, Any]] = []
    flattened = 0
    residual_results: list[dict[str, Any]] = []
    for row in residual_rows:
        symbol = str(row.get("symbol") or "")
        side = str(row.get("side") or "")
        qty = abs(phase6_mod.safe_float(row.get("qty")))
        if qty <= 0:
            continue
        trace_id = phase6_mod.make_trace_id(f"rank213-residual-{symbol}-{side}")
        close_side = phase6_mod.exit_order_side(side)
        close_cid = phase6_mod.make_client_order_id("rf", symbol, run_ctx, trace_id)
        market_close = bridge.place_binance_perp_live_market_order(
            symbol=symbol,
            side=close_side,
            quantity=qty,
            reduce_only=None,
            position_side=phase6_mod.hedge_position_side(side),
            client_order_id=close_cid,
        )
        market_close_n = phase6_mod.normalize_order_payload(market_close, source="rank213_exchange_residual_flatten")
        flattened_qty = abs(phase6_mod.safe_float(market_close_n.get("executed_qty"), qty))
        remaining_exchange_qty = max(0.0, qty - flattened_qty)
        residual_results.append({
            "symbol": symbol,
            "side": side,
            "requested_qty": qty,
            "flattened_qty": flattened_qty,
            "remaining_exchange_qty": remaining_exchange_qty,
            "reconciliation_classification": row.get("reconciliation_classification"),
            "basket_ids": row.get("matched_basket_ids") or row.get("opposite_side_basket_ids") or [],
            "rank213_owned": bool(row.get("rank213_owned")),
            "flatten_reason": reason,
        })
        orders_out.append({
            "timestamp": run_at_utc,
            "symbol": symbol,
            "side": close_side,
            "order_role": "residual_flatten",
            "order_type": "MARKET",
            "price": market_close_n.get("avg_price") or market_close_n.get("price"),
            "qty": market_close_n.get("executed_qty") or market_close_n.get("orig_qty"),
            "status": market_close_n.get("status"),
            "exchange_order_id": market_close_n.get("order_id"),
            "client_order_id": market_close_n.get("client_order_id"),
            "flatten_reason": reason,
        })
        phase6_mod.append_event(
            event_bus,
            events_written,
            phase6_mod.EventRecord(
                timestamp=run_at_utc,
                event_type=phase6_mod.EventType.ORDER_STATUS_SYNC,
                symbol=symbol,
                side=side,
                trace_id=trace_id,
                message="rank213 exchange residual flatten market close executed",
                payload={"reason": reason, "exchange_row": row, "close_order": market_close_n},
            ),
        )
        flattened += 1
    return orders_out, warnings_out, flattened, residual_results


def rank213_manage_live_positions(*, bridge: Any, phase6_state: Any, run_ctx: Any, event_bus: Any, events_written: list[dict[str, Any]], orders_out: list[dict[str, Any]], emitted_orders: list[dict[str, Any]], closed_out: list[dict[str, Any]], warnings_out: list[dict[str, Any]]) -> tuple[int, int]:
    managed = 0
    closed = 0
    keep_positions: list[dict[str, Any]] = []

    try:
        positions_payload = bridge.get_binance_perp_positions()
    except Exception as exc:
        phase6_mod.append_warning(warnings_out, trace_id=phase6_mod.make_trace_id("rank213-live-sync"), symbol="ACCOUNT", message="rank213 exchange positions query failed", payload={"error": str(exc)})
        return len(phase6_state.live_positions), 0

    quick_attempts = 1
    quick_sleep = 0.0

    for pos in phase6_state.live_positions:
        managed += 1
        trace_id = str(pos.get("trace_id") or phase6_mod.make_trace_id(str(pos.get("signal_id") or "rank213-live")))
        symbol = str(pos.get("symbol") or "")
        side = str(pos.get("side") or "")
        exchange_qty = phase6_mod.exchange_open_qty_for_position(positions_payload, symbol=symbol, side=side)
        planned_exit_ts = phase6_mod.parse_utc(str(pos.get("planned_exit_ts") or ""))
        entry_price = phase6_mod.safe_float(pos.get("entry_price"))

        if exchange_qty <= 0:
            exchange_qty_recheck = exchange_qty
            try:
                positions_payload_recheck = bridge.get_binance_perp_positions()
                exchange_qty_recheck = phase6_mod.exchange_open_qty_for_position(positions_payload_recheck, symbol=symbol, side=side)
                positions_payload = positions_payload_recheck
            except Exception as exc:
                phase6_mod.append_warning(warnings_out, trace_id=trace_id, symbol=symbol, message="rank213 exchange-flat recheck failed", payload={"error": str(exc)})
            if exchange_qty_recheck > 0:
                keep_positions.append(pos)
                continue
            exit_reason = "exchange_flat_reconciled_after_horizon" if planned_exit_ts is not None and run_ctx.now_dt >= planned_exit_ts else "external_flat_reconciled_before_horizon"
            exit_price = entry_price
            try:
                exit_price = bridge.get_binance_perp_last_price(symbol)
            except Exception:
                pass
            if phase6_mod.safe_float(exit_price) <= 0:
                exit_price = entry_price
            close_row = phase6_mod.close_position_record(pos=pos, exit_price=exit_price, exit_time_iso=run_ctx.now_iso, exit_reason=exit_reason)
            closed_out.append(close_row)
            phase6_mod.append_event(
                event_bus,
                events_written,
                phase6_mod.EventRecord(
                    timestamp=run_ctx.now_iso,
                    event_type=phase6_mod.EventType.POSITION_CLOSED,
                    symbol=symbol,
                    side=side,
                    trace_id=trace_id,
                    message="rank213 live position reconciled flat on exchange",
                    payload={"close_row": close_row, "exchange_qty": exchange_qty_recheck},
                ),
            )
            closed += 1
            continue

        if planned_exit_ts is None or run_ctx.now_dt < planned_exit_ts:
            keep_positions.append(pos)
            continue

        timeout_exit_order_id = pos.get("timeout_exit_order_id")
        timeout_exit_client_order_id = pos.get("timeout_exit_client_order_id")
        if timeout_exit_order_id or timeout_exit_client_order_id:
            try:
                positions_payload_recheck = bridge.get_binance_perp_positions()
                exchange_qty_recheck = phase6_mod.exchange_open_qty_for_position(positions_payload_recheck, symbol=symbol, side=side)
                positions_payload = positions_payload_recheck
            except Exception as exc:
                phase6_mod.append_warning(warnings_out, trace_id=trace_id, symbol=symbol, message="rank213 horizon exit recheck failed", payload={"error": str(exc)})
                keep_positions.append(pos)
                continue
            if exchange_qty_recheck > 0:
                keep_positions.append(pos)
                continue
            exit_price = entry_price
            try:
                close_snap = phase6_mod.query_order_with_retry(
                    bridge,
                    symbol=symbol,
                    order_id=timeout_exit_order_id,
                    client_order_id=timeout_exit_client_order_id,
                    attempts=quick_attempts,
                    sleep_seconds=quick_sleep,
                )
                exit_price = phase6_mod.safe_float(close_snap.get("avgPrice"), phase6_mod.safe_float(close_snap.get("price"), entry_price))
            except Exception:
                try:
                    exit_price = bridge.get_binance_perp_last_price(symbol)
                except Exception:
                    exit_price = entry_price
            if phase6_mod.safe_float(exit_price) <= 0:
                exit_price = entry_price
            close_row = phase6_mod.close_position_record(pos=pos, exit_price=exit_price, exit_time_iso=run_ctx.now_iso, exit_reason="horizon_market_reconciled")
            closed_out.append(close_row)
            phase6_mod.append_event(
                event_bus,
                events_written,
                phase6_mod.EventRecord(
                    timestamp=run_ctx.now_iso,
                    event_type=phase6_mod.EventType.POSITION_CLOSED,
                    symbol=symbol,
                    side=side,
                    trace_id=trace_id,
                    message="rank213 horizon close reconciled flat on exchange",
                    payload={"planned_exit_ts": pos.get("planned_exit_ts"), "close_row": close_row},
                ),
            )
            closed += 1
            continue

        close_side = phase6_mod.exit_order_side(side)
        close_qty = max(exchange_qty, 0.0)
        if close_qty <= 0:
            keep_positions.append(pos)
            continue
        close_cid = phase6_mod.make_client_order_id("hz", symbol, run_ctx, trace_id)
        market_close = bridge.place_binance_perp_live_market_order(
            symbol=symbol,
            side=close_side,
            quantity=close_qty,
            reduce_only=None,
            position_side=phase6_mod.hedge_position_side(side),
            client_order_id=close_cid,
        )
        market_close_n = phase6_mod.normalize_order_payload(market_close, source="rank213_horizon_exit")
        horizon_order_row = {
            "timestamp": run_ctx.now_iso,
            "symbol": symbol,
            "side": close_side,
            "order_role": "horizon_exit",
            "order_type": "MARKET",
            "price": market_close_n.get("avg_price") or market_close_n.get("price"),
            "qty": market_close_n.get("executed_qty") or market_close_n.get("orig_qty"),
            "status": market_close_n.get("status"),
            "exchange_order_id": market_close_n.get("order_id"),
            "client_order_id": market_close_n.get("client_order_id"),
        }
        orders_out.append(horizon_order_row)
        emitted_orders.append(horizon_order_row)
        exit_status = str(market_close_n.get("status") or "").upper()
        if exit_status == "FILLED":
            exit_price = phase6_mod.safe_float(market_close_n.get("avg_price"), phase6_mod.safe_float(market_close_n.get("price"), entry_price))
            if phase6_mod.safe_float(exit_price) <= 0:
                exit_price = entry_price
            close_row = phase6_mod.close_position_record(pos=pos, exit_price=exit_price, exit_time_iso=run_ctx.now_iso, exit_reason="horizon_market_filled")
            closed_out.append(close_row)
            phase6_mod.append_event(
                event_bus,
                events_written,
                phase6_mod.EventRecord(
                    timestamp=run_ctx.now_iso,
                    event_type=phase6_mod.EventType.POSITION_CLOSED,
                    symbol=symbol,
                    side=side,
                    trace_id=trace_id,
                    message="rank213 horizon reached and market close filled immediately",
                    payload={"planned_exit_ts": pos.get("planned_exit_ts"), "close_row": close_row, "close_order": market_close_n},
                ),
            )
            closed += 1
            continue
        pos["timeout_exit_order_id"] = market_close_n.get("order_id")
        pos["timeout_exit_client_order_id"] = market_close_n.get("client_order_id")
        keep_positions.append(pos)
        phase6_mod.append_event(
            event_bus,
            events_written,
            phase6_mod.EventRecord(
                timestamp=run_ctx.now_iso,
                event_type=phase6_mod.EventType.ORDER_STATUS_SYNC,
                symbol=symbol,
                side=side,
                trace_id=trace_id,
                message="rank213 horizon reached and market close submitted pending exchange reconciliation",
                payload={"planned_exit_ts": pos.get("planned_exit_ts"), "close_order": market_close_n},
            ),
        )

    phase6_state.live_positions = keep_positions
    return managed, closed


def sync_phase6_runtime(*, bridge: Any, cfg: dict[str, Any], paths: dict[str, Path], shell_state: dict[str, Any], pending_entries: list[dict[str, Any]], live_positions: list[dict[str, Any]], closed_trades: list[dict[str, Any]], run_at_utc: str, metadata_rows: list[dict[str, Any]], manage_live_positions: bool = True) -> tuple[list[dict[str, Any]], list[dict[str, Any]], list[dict[str, Any]], list[dict[str, Any]], list[dict[str, Any]], dict[str, int]]:
    phase6_state = phase6_mod.Phase6State({
        "enabled_symbols": list(cfg.get("universe", {}).get("symbols", [])),
        "seen_signal_ids": list(shell_state.get("executed_intention_ids", [])),
        "consumed_signal_bars": list(shell_state.get("accepted_bar_keys", [])),
        "pending_entries": pending_entries,
        "live_positions": live_positions,
        "closed_trades": closed_trades,
        "last_run_utc": shell_state.get("last_run_at_utc"),
    })
    run_ctx = phase6_mod.RunContext(now_iso=run_at_utc, now_dt=pd.to_datetime(run_at_utc, utc=True).to_pydatetime())
    event_bus = phase6_mod.JsonlEventBus(paths["events"])
    events_written: list[dict[str, Any]] = []
    orders_out: list[dict[str, Any]] = []
    emitted_orders: list[dict[str, Any]] = []
    warnings_out: list[dict[str, Any]] = []
    closed_out: list[dict[str, Any]] = []

    managed_pending, moved_to_live = rank213_manage_pending_entries(
        bridge=bridge,
        cfg=cfg,
        phase6_state=phase6_state,
        run_ctx=run_ctx,
        event_bus=event_bus,
        events_written=events_written,
        orders_out=orders_out,
        emitted_orders=emitted_orders,
        warnings_out=warnings_out,
        exchange_reconciliation=reconcile_exchange_positions(
            basket_id=None,
            exchange_positions=collect_exchange_open_positions(bridge=bridge, cfg=cfg),
            pending_entries=list(phase6_state.pending_entries),
            live_positions=list(phase6_state.live_positions),
            closed_trades=list(getattr(phase6_state, "closed_trades", [])),
            order_rows=dryrun_mod.read_json(paths["orders"], []),
            now_utc=run_at_utc,
        ),
    )
    managed_live = 0
    closed_count = 0
    if manage_live_positions:
        managed_live, closed_count = rank213_manage_live_positions(
            bridge=bridge,
            phase6_state=phase6_state,
            run_ctx=run_ctx,
            event_bus=event_bus,
            events_written=events_written,
            orders_out=orders_out,
            emitted_orders=emitted_orders,
            closed_out=closed_out,
            warnings_out=warnings_out,
        )
    phase6_state.closed_trades.extend(closed_out)
    meta_index = build_basket_metadata_index(metadata_rows, pending_entries, live_positions, closed_trades)
    pending_entries_out = apply_basket_metadata(phase6_state.pending_entries, meta_index)
    live_positions_out = apply_basket_metadata(phase6_state.live_positions, meta_index)
    closed_trades_out = apply_basket_metadata(phase6_state.closed_trades, meta_index)
    orders_out = apply_basket_metadata(orders_out, meta_index)
    return pending_entries_out, live_positions_out, closed_trades_out, orders_out, warnings_out, {
        "managed_pending": managed_pending,
        "moved_to_live": moved_to_live,
        "managed_live": managed_live,
        "closed_count": closed_count,
    }



def _normalize_side(value: Any) -> str:
    side = str(value or "").strip().lower()
    if side in {"buy", "long"}:
        return "long"
    if side in {"sell", "short"}:
        return "short"
    return side



def _safe_abs_qty(*values: Any) -> float:
    for value in values:
        qty = abs(dryrun_mod.safe_float(value, 0.0))
        if qty > 0:
            return qty
    return 0.0



def _ttl_fallback_blockers_for_basket(*, exchange_reconciliation: dict[str, Any], basket_id: str | None) -> tuple[list[str], dict[str, Any]]:
    summary = exchange_reconciliation.get("summary", {}) if isinstance(exchange_reconciliation.get("summary"), dict) else {}
    if basket_id:
        close_conflict_count = int(summary.get("non_current_close_conflict_residual_count", summary.get("close_conflict_residual_count", 0)) or 0)
        close_conflict_symbols = list(summary.get("non_current_close_conflict_residual_symbols", summary.get("close_conflict_residual_symbols", [])) or [])
        opposite_side_count = int(summary.get("non_current_opposite_side_conflict_count", summary.get("opposite_side_conflict_count", 0)) or 0)
        opposite_side_symbols = list(summary.get("non_current_opposite_side_conflict_symbols", summary.get("opposite_side_conflict_symbols", [])) or [])
    else:
        close_conflict_count = int(summary.get("close_conflict_residual_count", 0) or 0)
        close_conflict_symbols = list(summary.get("close_conflict_residual_symbols", []) or [])
        opposite_side_count = int(summary.get("opposite_side_conflict_count", 0) or 0)
        opposite_side_symbols = list(summary.get("opposite_side_conflict_symbols", []) or [])
    residual_open_count = int(summary.get("residual_open_on_exchange_count", 0) or 0)
    residual_open_symbols = list(summary.get("residual_open_on_exchange_symbols", []) or [])
    blockers: list[str] = []
    if close_conflict_count > 0:
        blockers.append("close_conflict_residual")
    if residual_open_count > 0:
        blockers.append("residual_open_on_exchange")
    if opposite_side_count > 0:
        blockers.append("opposite_side_conflict")
    return blockers, {
        "basket_id": basket_id,
        "close_conflict_residual_count": close_conflict_count,
        "close_conflict_residual_symbols": close_conflict_symbols,
        "residual_open_on_exchange_count": residual_open_count,
        "residual_open_on_exchange_symbols": residual_open_symbols,
        "opposite_side_conflict_count": opposite_side_count,
        "opposite_side_conflict_symbols": opposite_side_symbols,
        "current_basket_claimed_symbols": list(summary.get("current_basket_claimed_symbols", []) or []),
        "current_basket_close_conflict_symbols": list(summary.get("current_basket_close_conflict_symbols", []) or []),
        "current_basket_opposite_side_conflict_symbols": list(summary.get("current_basket_opposite_side_conflict_symbols", []) or []),
    }



def reconcile_exchange_positions(*, basket_id: str | None, exchange_positions: list[dict[str, Any]], pending_entries: list[dict[str, Any]], live_positions: list[dict[str, Any]], closed_trades: list[dict[str, Any]], order_rows: list[dict[str, Any]] | None = None, now_utc: str | None = None) -> dict[str, Any]:
    local_claims: dict[tuple[str, str], list[dict[str, Any]]] = {}
    reconciliation_now = phase6_mod.parse_utc(str(now_utc or ""))
    residual_claim_max_age = pd.Timedelta(hours=6)

    def add_claim(rows: list[dict[str, Any]], local_status: str, qty_fields: tuple[str, ...]) -> None:
        for row in rows:
            symbol = str(row.get("symbol") or "").upper().strip()
            side = _normalize_side(row.get("side"))
            if not symbol or side not in {"long", "short"}:
                continue
            if local_status == "order_history":
                order_role = str(row.get("order_role") or "").lower()
                order_status = str(row.get("status") or "").upper()
                if order_role not in {"entry", "entry_fallback", "entry_rejected_post_only"}:
                    continue
                if order_status not in {"NEW", "PARTIALLY_FILLED", "FILLED", "FILLED_RECONSTRUCTED", "REJECTED_POST_ONLY"}:
                    continue
            qty = _safe_abs_qty(*(row.get(field) for field in qty_fields))
            claim = {
                "symbol": symbol,
                "side": side,
                "local_status": local_status,
                "basket_id": row.get("basket_id"),
                "basket_role": row.get("basket_role"),
                "qty": qty,
                "trace_id": row.get("trace_id"),
                "intention_id": row.get("intention_id"),
                "signal_timestamp": row.get("signal_timestamp") or row.get("decision_ts"),
                "signal_price": row.get("signal_price"),
                "planned_exit_ts": row.get("planned_exit_ts"),
                "entry_policy_mode": row.get("entry_policy_mode"),
                "submit_outcome": row.get("submit_outcome"),
                "fallback_reason": row.get("fallback_reason"),
                "entry_time": row.get("entry_time") or row.get("entry_submit_at") or row.get("timestamp"),
                "entry_price": row.get("entry_price") or row.get("price"),
                "exit_time": row.get("exit_time"),
                "exit_reason": row.get("exit_reason"),
                "order_role": row.get("order_role"),
                "order_status": row.get("status"),
            }
            local_claims.setdefault((symbol, side), []).append(claim)

    add_claim(pending_entries, "pending_entry", ("planned_qty", "qty"))
    add_claim(live_positions, "live_open", ("entry_qty", "qty"))
    add_claim(closed_trades, "closed", ("qty", "entry_qty", "planned_qty"))
    add_claim(order_rows or [], "order_history", ("qty", "executed_qty", "orig_qty", "planned_qty"))

    reconciled: list[dict[str, Any]] = []
    summary_counts = {
        "claimed_by_local_state": 0,
        "close_conflict_residual": 0,
        "residual_open_on_exchange": 0,
    }
    direction_counts = {
        "same_side_exposure": 0,
        "opposite_side_conflict": 0,
    }
    symbols_by_classification = {key: [] for key in summary_counts}
    symbols_by_direction = {key: [] for key in direction_counts}
    current_basket_claimed = 0
    current_basket_close_conflicts = 0
    current_basket_same_side = 0
    current_basket_opposite_side = 0
    current_basket_claimed_symbols: list[str] = []
    current_basket_close_conflict_symbols: list[str] = []
    current_basket_same_side_symbols: list[str] = []
    current_basket_opposite_side_symbols: list[str] = []
    non_current_close_conflict_symbols: list[str] = []
    non_current_opposite_side_symbols: list[str] = []

    for row in exchange_positions:
        symbol = str(row.get("symbol") or "").upper().strip()
        side = _normalize_side(row.get("side"))
        claims = list(local_claims.get((symbol, side), []))
        opposite_side = "short" if side == "long" else "long"
        opposite_claims = list(local_claims.get((symbol, opposite_side), [])) if side in {"long", "short"} else []
        active_claims = [claim for claim in claims if claim.get("local_status") in {"pending_entry", "live_open"}]
        closed_claims = [claim for claim in claims if claim.get("local_status") == "closed"]
        if reconciliation_now is not None:
            fresh_closed_claims: list[dict[str, Any]] = []
            for claim in closed_claims:
                exit_ts = phase6_mod.parse_utc(str(claim.get("exit_time") or ""))
                if exit_ts is None:
                    continue
                if reconciliation_now - exit_ts <= residual_claim_max_age:
                    fresh_closed_claims.append(claim)
            closed_claims = fresh_closed_claims
        current_basket_claims = [
            claim for claim in claims
            if basket_id and str(claim.get("basket_id") or "") == str(basket_id)
        ]
        current_basket_entry_history_claims = [
            claim for claim in current_basket_claims
            if claim.get("local_status") == "order_history"
            and str(claim.get("order_role") or "") in {"entry", "entry_fallback"}
            and str(claim.get("order_status") or "").upper() in {"NEW", "PARTIALLY_FILLED", "FILLED", "FILLED_RECONSTRUCTED"}
        ]
        active_or_current_entry_claims = [*active_claims, *current_basket_entry_history_claims]
        active_opposite_claims = [claim for claim in opposite_claims if claim.get("local_status") in {"pending_entry", "live_open"}]
        current_basket_closed_claims = [
            claim for claim in closed_claims
            if basket_id and str(claim.get("basket_id") or "") == str(basket_id)
        ]
        historical_closed_claims = [
            claim for claim in closed_claims
            if not basket_id or str(claim.get("basket_id") or "") != str(basket_id)
        ]
        if active_or_current_entry_claims or current_basket_closed_claims:
            classification = "claimed_by_local_state"
        elif historical_closed_claims:
            classification = "close_conflict_residual"
        else:
            classification = "residual_open_on_exchange"
        direction = "same_side_exposure" if active_or_current_entry_claims else ("opposite_side_conflict" if active_opposite_claims else None)
        summary_counts[classification] += 1
        symbols_by_classification[classification].append(symbol)
        if direction is not None:
            direction_counts[direction] += 1
            symbols_by_direction[direction].append(symbol)
        matched_basket_ids = sorted({str(claim.get("basket_id") or "") for claim in claims if claim.get("basket_id")})
        opposite_matched_basket_ids = sorted({str(claim.get("basket_id") or "") for claim in opposite_claims if claim.get("basket_id")})
        if basket_id and str(basket_id) in matched_basket_ids:
            if classification == "claimed_by_local_state":
                current_basket_claimed += 1
                current_basket_claimed_symbols.append(symbol)
            elif classification == "close_conflict_residual":
                current_basket_close_conflicts += 1
                current_basket_close_conflict_symbols.append(symbol)
            if direction == "same_side_exposure":
                current_basket_same_side += 1
                current_basket_same_side_symbols.append(symbol)
        elif classification == "close_conflict_residual":
            non_current_close_conflict_symbols.append(symbol)
        if basket_id and str(basket_id) in opposite_matched_basket_ids and direction == "opposite_side_conflict":
            current_basket_opposite_side += 1
            current_basket_opposite_side_symbols.append(symbol)
        elif direction == "opposite_side_conflict":
            non_current_opposite_side_symbols.append(symbol)
        reconciled.append({
            **row,
            "reconciliation_classification": classification,
            "directional_classification": direction,
            "matched_local_claim_count": len(claims),
            "matched_local_statuses": [claim.get("local_status") for claim in claims],
            "matched_basket_ids": matched_basket_ids,
            "matched_local_claims": claims,
            "opposite_side_claim_count": len(opposite_claims),
            "opposite_side_statuses": [claim.get("local_status") for claim in opposite_claims],
            "opposite_side_basket_ids": opposite_matched_basket_ids,
            "opposite_side_claims": opposite_claims,
            "rank213_owned": bool(claims or opposite_claims),
        })

    for key in symbols_by_classification:
        symbols_by_classification[key] = sorted(set(symbols_by_classification[key]))
    for key in symbols_by_direction:
        symbols_by_direction[key] = sorted(set(symbols_by_direction[key]))

    return {
        "positions": reconciled,
        "summary": {
            "exchange_open_count": len(reconciled),
            "claimed_by_local_state_count": summary_counts["claimed_by_local_state"],
            "close_conflict_residual_count": summary_counts["close_conflict_residual"],
            "residual_open_on_exchange_count": summary_counts["residual_open_on_exchange"],
            "claimed_by_local_state_symbols": symbols_by_classification["claimed_by_local_state"],
            "close_conflict_residual_symbols": symbols_by_classification["close_conflict_residual"],
            "residual_open_on_exchange_symbols": symbols_by_classification["residual_open_on_exchange"],
            "same_side_exposure_count": direction_counts["same_side_exposure"],
            "opposite_side_conflict_count": direction_counts["opposite_side_conflict"],
            "same_side_exposure_symbols": symbols_by_direction["same_side_exposure"],
            "opposite_side_conflict_symbols": symbols_by_direction["opposite_side_conflict"],
            "current_basket_claimed_exchange_count": current_basket_claimed,
            "current_basket_close_conflict_count": current_basket_close_conflicts,
            "current_basket_same_side_exposure_count": current_basket_same_side,
            "current_basket_opposite_side_conflict_count": current_basket_opposite_side,
            "current_basket_claimed_symbols": sorted(set(current_basket_claimed_symbols)),
            "current_basket_close_conflict_symbols": sorted(set(current_basket_close_conflict_symbols)),
            "current_basket_same_side_exposure_symbols": sorted(set(current_basket_same_side_symbols)),
            "current_basket_opposite_side_conflict_symbols": sorted(set(current_basket_opposite_side_symbols)),
            "non_current_close_conflict_residual_count": len(sorted(set(non_current_close_conflict_symbols))),
            "non_current_close_conflict_residual_symbols": sorted(set(non_current_close_conflict_symbols)),
            "non_current_opposite_side_conflict_count": len(sorted(set(non_current_opposite_side_symbols))),
            "non_current_opposite_side_conflict_symbols": sorted(set(non_current_opposite_side_symbols)),
        },
    }



def classify_basket_safety(*, basket_id: str | None, basket_runtime: dict[str, Any], basket_parity: dict[str, Any], reconciliation: dict[str, Any], cfg: dict[str, Any]) -> dict[str, Any]:
    basket_controls = cfg.get("basket_controls", {}) if isinstance(cfg.get("basket_controls"), dict) else {}
    canary_controls = cfg.get("canary_controls", {}) if isinstance(cfg.get("canary_controls"), dict) else {}
    summary = reconciliation.get("summary", {}) if isinstance(reconciliation.get("summary"), dict) else {}
    realized = basket_parity.get("realized_basket", {}) if isinstance(basket_parity.get("realized_basket"), dict) else {}
    lifecycle = realized.get("lifecycle", []) if isinstance(realized.get("lifecycle"), list) else []
    submitted = basket_parity.get("submitted_basket", {}) if isinstance(basket_parity.get("submitted_basket"), dict) else {}
    intended = basket_parity.get("intended_basket", {}) if isinstance(basket_parity.get("intended_basket"), dict) else {}
    parity_safety = basket_parity.get("basket_safety", {}) if isinstance(basket_parity.get("basket_safety"), dict) else {}
    basket_status = str(basket_runtime.get("basket_status") or "").lower()
    active_statuses = {"planned", "pending_entries", "partially_filled", "live", "partial_submit_failure", "partial_submit_closed", "flattening", "incomplete_non_comparable"}
    active_like = basket_status in active_statuses

    protected_statuses = {"pending_entry", "live_open", "closed", "order_history"}
    long_count = sum(1 for row in lifecycle if _normalize_side(row.get("intended_side")) == "long" and str(row.get("status") or "") in protected_statuses)
    short_count = sum(1 for row in lifecycle if _normalize_side(row.get("intended_side")) == "short" and str(row.get("status") or "") in protected_statuses)
    submitted_count = int(submitted.get("symbol_count", 0) or 0)
    intended_count = int(intended.get("symbol_count", 0) or 0)
    materialized_basket = submitted_count > 0 or long_count > 0 or short_count > 0
    min_total = int(basket_controls.get("min_filled_legs_total", 4))
    min_per_side = int(basket_controls.get("min_filled_legs_per_side", 2))
    max_missing_total = int(basket_controls.get("max_missing_legs_total", 2))
    max_nominal_imbalance = phase6_mod.safe_float(basket_controls.get("max_nominal_imbalance_usdt", 8.0), 8.0)
    max_side_imbalance = phase6_mod.safe_float(basket_controls.get("max_side_imbalance_usdt", 6.0), 6.0)
    require_complete_basket = bool(basket_controls.get("require_complete_basket", False))
    missing_legs_total = int(parity_safety.get("missing_legs_total", max(0, intended_count - submitted_count)) or 0)
    nominal_imbalance_usdt = phase6_mod.safe_float(parity_safety.get("nominal_imbalance_usdt"), 0.0)
    side_imbalance_usdt = phase6_mod.safe_float(parity_safety.get("side_imbalance_usdt"), 0.0)
    materialized_leg_count = int(basket_runtime.get("legs_materialized", submitted_count) or 0)
    unmaterialized_leg_count = int(basket_runtime.get("legs_unmaterialized", missing_legs_total) or 0)
    pending_leg_count = int(basket_runtime.get("legs_pending", 0) or 0)
    materialization_in_progress = pending_leg_count > 0
    parity_safe_to_compare = bool(parity_safety.get("safe_to_compare_economics", intended_count > 0 and missing_legs_total == 0))
    basket_comparable = bool(materialized_basket and parity_safe_to_compare)

    reasons: list[dict[str, Any]] = []
    flatten_required = False
    block_new_entries = False

    if int(summary.get("close_conflict_residual_count", 0) or 0) > 0:
        reasons.append({
            "reason": "close_conflict_residual",
            "symbols": summary.get("close_conflict_residual_symbols", []),
        })
        block_new_entries = True

    if int(summary.get("residual_open_on_exchange_count", 0) or 0) > 0:
        reasons.append({
            "reason": "residual_open_on_exchange",
            "symbols": summary.get("residual_open_on_exchange_symbols", []),
        })
        block_new_entries = True

    if int(summary.get("opposite_side_conflict_count", 0) or 0) > 0:
        reasons.append({
            "reason": "opposite_side_conflict",
            "symbols": summary.get("opposite_side_conflict_symbols", []),
        })
        block_new_entries = True
        flatten_required = True

    if active_like and materialized_basket and submitted_count > 0 and submitted_count < min_total:
        reasons.append({
            "reason": "partial_basket_under_min_legs",
            "submitted_leg_count": submitted_count,
            "min_required": min_total,
            "materialization_in_progress": materialization_in_progress,
            "pending_leg_count": pending_leg_count,
        })
        block_new_entries = True

    if active_like and materialized_basket and (long_count < min_per_side or short_count < min_per_side):
        reasons.append({
            "reason": "basket_side_under_min_legs",
            "long_count": long_count,
            "short_count": short_count,
            "min_required": min_per_side,
            "materialization_in_progress": materialization_in_progress,
            "pending_leg_count": pending_leg_count,
        })
        block_new_entries = True

    if active_like and materialized_basket and require_complete_basket and intended_count > 0 and submitted_count != intended_count:
        reasons.append({
            "reason": "require_complete_basket",
            "submitted_leg_count": submitted_count,
            "intended_leg_count": intended_count,
            "materialization_in_progress": materialization_in_progress,
            "pending_leg_count": pending_leg_count,
        })
        block_new_entries = True

    if active_like and materialized_basket and missing_legs_total > max_missing_total:
        reasons.append({
            "reason": "too_many_missing_legs",
            "actual": missing_legs_total,
            "max_allowed": max_missing_total,
            "materialization_in_progress": materialization_in_progress,
            "pending_leg_count": pending_leg_count,
        })
        block_new_entries = True

    if active_like and materialized_basket and nominal_imbalance_usdt > max_nominal_imbalance:
        reasons.append({
            "reason": "nominal_imbalance_too_large",
            "actual": nominal_imbalance_usdt,
            "max_allowed": max_nominal_imbalance,
            "materialization_in_progress": materialization_in_progress,
            "pending_leg_count": pending_leg_count,
            "incomplete_basket": submitted_count != intended_count if intended_count > 0 else False,
        })
        block_new_entries = True
        if not materialization_in_progress and intended_count > 0 and submitted_count == intended_count:
            flatten_required = flatten_required or bool(canary_controls.get("reject_if_nominal_imbalance_exceeds_limit", False))

    if active_like and materialized_basket and side_imbalance_usdt > max_side_imbalance:
        reasons.append({
            "reason": "side_imbalance_too_large",
            "actual": side_imbalance_usdt,
            "max_allowed": max_side_imbalance,
            "materialization_in_progress": materialization_in_progress,
            "pending_leg_count": pending_leg_count,
            "incomplete_basket": submitted_count != intended_count if intended_count > 0 else False,
        })
        block_new_entries = True
        if not materialization_in_progress and intended_count > 0 and submitted_count == intended_count:
            flatten_required = flatten_required or bool(canary_controls.get("flatten_if_side_imbalance_persists", False))

    if flatten_required:
        classification = "flatten_required"
    elif block_new_entries:
        classification = "blocked"
    elif basket_status == "closed" and int(summary.get("exchange_open_count", 0) or 0) == 0:
        classification = "closed_clean"
    else:
        classification = "healthy"

    comparability_classification = "comparable"
    if not basket_comparable:
        comparability_classification = (
            "flattening_non_comparable" if flatten_required else ("blocked_non_comparable" if block_new_entries else "incomplete_non_comparable")
        )

    return {
        "basket_id": basket_id,
        "classification": classification,
        "block_new_entries": block_new_entries,
        "flatten_required": flatten_required,
        "current_basket_status": basket_status,
        "current_basket_submitted_leg_count": submitted_count,
        "current_basket_long_leg_count": long_count,
        "current_basket_short_leg_count": short_count,
        "missing_legs_total": missing_legs_total,
        "nominal_imbalance_usdt": nominal_imbalance_usdt,
        "side_imbalance_usdt": side_imbalance_usdt,
        "require_complete_basket": require_complete_basket,
        "basket_comparable": basket_comparable,
        "comparability_classification": comparability_classification,
        "materialized_leg_count": materialized_leg_count,
        "unmaterialized_leg_count": unmaterialized_leg_count,
        "pending_leg_count": pending_leg_count,
        "materialization_in_progress": materialization_in_progress,
        "reasons": reasons,
        "reconciliation_summary": summary,
    }



def summarize_basket_runtime(*, basket_id: str | None, bar_key: Any, decision_ts: Any, planned_exit_ts: Any, official_window: dict[str, Any], state: dict[str, Any], live_positions: list[dict[str, Any]], pending_entries: list[dict[str, Any]], closed_trades: list[dict[str, Any]], live_shell_armed: bool, bridge_connected: bool, submit_stats: dict[str, int] | None = None, exchange_positions: list[dict[str, Any]] | None = None, exchange_reconciliation: dict[str, Any] | None = None, basket_safety: dict[str, Any] | None = None) -> dict[str, Any]:
    basket_pending = [row for row in pending_entries if str(row.get("basket_id") or "") == str(basket_id or "")]
    basket_live = [row for row in live_positions if str(row.get("basket_id") or "") == str(basket_id or "")]
    basket_closed = [row for row in closed_trades if str(row.get("basket_id") or "") == str(basket_id or "")]
    exchange_positions = exchange_positions or []
    submit_stats = submit_stats or {}
    legs_submit_failed = int(submit_stats.get("legs_submit_failed", 0))
    legs_attempted = int(submit_stats.get("legs_attempted", 0))
    legs_materialized = int(submit_stats.get("legs_materialized", 0))
    legs_unmaterialized = int(submit_stats.get("legs_unmaterialized", 0))
    basket_comparable = bool(submit_stats.get("basket_comparable", legs_attempted > 0 and legs_unmaterialized == 0))
    if basket_live and not basket_comparable:
        basket_status = "incomplete_non_comparable"
    elif basket_pending and not basket_comparable:
        basket_status = "incomplete_non_comparable"
    elif basket_live:
        basket_status = "live"
    elif basket_pending and basket_closed:
        basket_status = "partially_filled"
    elif basket_pending:
        basket_status = "pending_entries"
    elif basket_closed:
        basket_status = "closed"
    elif legs_submit_failed > 0 and legs_attempted > 0 and int(submit_stats.get("legs_submitted", 0)) > 0:
        basket_status = "partial_submit_closed"
    elif legs_submit_failed > 0 and legs_attempted > 0:
        basket_status = "partial_submit_failure"
    elif live_shell_armed:
        basket_status = "planned"
    else:
        basket_status = "aborted"
    exchange_reconciliation = exchange_reconciliation or {}
    basket_safety = basket_safety or {}
    return {
        "basket_id": basket_id,
        "basket_status": basket_status,
        "bar_key": bar_key,
        "decision_ts": decision_ts,
        "planned_exit_ts": planned_exit_ts,
        "entry_window": official_window,
        "legs_planned": max(
            legs_attempted,
            len(basket_pending) + len(basket_live) + len(basket_closed) + max(0, legs_attempted - int(submit_stats.get("legs_submitted", 0))),
        ),
        "legs_attempted": legs_attempted,
        "legs_submitted": int(submit_stats.get("legs_submitted", 0)),
        "legs_submit_failed": legs_submit_failed,
        "legs_failed_post_only": int(submit_stats.get("legs_failed_post_only", 0)),
        "legs_materialized": legs_materialized,
        "legs_unmaterialized": legs_unmaterialized,
        "basket_comparable": basket_comparable,
        "comparability_classification": "comparable" if basket_comparable else ("incomplete_flattening" if basket_status == "flattening" else "incomplete_non_comparable"),
        "unmaterialized_symbols": list(submit_stats.get("unmaterialized_symbols", [])),
        "legs_pending": len(basket_pending),
        "legs_live": len(basket_live),
        "legs_closed": len(basket_closed),
        "legs_failed": legs_submit_failed,
        "pending_entry_symbols": [row.get("symbol") for row in basket_pending],
        "live_symbols": [row.get("symbol") for row in basket_live],
        "closed_symbols": [row.get("symbol") for row in basket_closed],
        "exchange_open_symbols": [row.get("symbol") for row in exchange_positions],
        "exchange_open_count": len(exchange_positions),
        "exchange_open_symbol_count": len({str(row.get("symbol") or "") for row in exchange_positions if str(row.get("symbol") or "")}),
        "live_exchange_symbol_count": len({str(row.get("symbol") or "") for row in basket_live if str(row.get("symbol") or "")}),
        "exchange_reconciliation_summary": exchange_reconciliation.get("summary", {}),
        "basket_safety": basket_safety,
        "flatten_reason": state.get("basket_flatten_reason"),
        "runtime_mode": "rank213_horizon_runtime" if bridge_connected else "guarded_shell",
        "bridge_connected": bridge_connected,
        "bridge_reuse_target": "rank213_native_horizon_exit",
    }


def main() -> int:
    ap = argparse.ArgumentParser(description="Run rank213 live canary shell")
    ap.add_argument("--config", default=str(CONFIG_PATH))
    ap.add_argument("--allow-live", action="store_true", help="Arm live shell only when config also enables it. When armed, this script can place real orders through the guarded phase6 bridge.")
    ap.add_argument("--pending-only", action="store_true", help="Only manage existing pending maker entries; do not admit or submit new baskets.")
    args = ap.parse_args()

    cfg = dryrun_mod.load_yaml(Path(args.config))
    paths = build_shell_paths(cfg)
    dryrun_mod.ensure_dir(paths["root"])
    paths["config_snapshot"].write_text(Path(args.config).read_text(encoding="utf-8"), encoding="utf-8")

    shadow_cfg = cfg.get("shadow_parity", {}) if isinstance(cfg.get("shadow_parity"), dict) else {}
    shadow_status_path = Path(str(shadow_cfg.get("shadow_status_path") or ""))
    shadow_current_path = Path(str(shadow_cfg.get("shadow_current_decision_path") or ""))
    shadow_warnings_path = shadow_status_path.with_name("rank213_shadow_warnings.json") if str(shadow_status_path) else Path()
    shadow_status = dryrun_mod.read_json(shadow_status_path, {})
    shadow_current = dryrun_mod.read_json(shadow_current_path, {})
    shadow_warnings = dryrun_mod.read_json(shadow_warnings_path, [])
    if not isinstance(shadow_status, dict):
        shadow_status = {}
    if not isinstance(shadow_current, dict):
        shadow_current = {}
    if not isinstance(shadow_warnings, list):
        shadow_warnings = []

    run_at_utc = dryrun_mod.iso_z(dryrun_mod.utc_now())
    run_now_ts = dryrun_mod.parse_ts(run_at_utc)
    state = dryrun_mod.load_state(paths["state"])
    rejection_state = dict(state)
    current_bar_key = str(shadow_current.get("bar_key") or "")
    allow_live_replay_same_bar = bool(args.allow_live)
    if allow_live_replay_same_bar and current_bar_key:
        accepted_bar_keys = [
            str(x) for x in rejection_state.get("accepted_bar_keys", []) if x and str(x) != current_bar_key
        ]
        rejection_state["accepted_bar_keys"] = accepted_bar_keys
    warnings, rejections, rejection_reasons, basket_metrics, official_window = dryrun_mod.evaluate_rejections(
        shadow_current,
        shadow_status,
        cfg,
        rejection_state,
        now_ts=run_now_ts,
        mode="live_shell",
    )
    cooldown_probe_state = dict(state)
    current_non_cooldown_rejection_reasons = [
        str(x.get("reason")) for x in rejection_reasons if str(x.get("reason") or "") != "cooldown_active"
    ]
    if current_non_cooldown_rejection_reasons:
        cooldown_probe_state["last_rejection_reasons"] = current_non_cooldown_rejection_reasons
    cooldown = dryrun_mod.cooldown_active(cooldown_probe_state, cfg, now_ts=run_now_ts) if run_now_ts is not None else None
    if cooldown is not None:
        rejections.append({
            "timestamp": run_at_utc,
            "bar_key": shadow_current.get("bar_key"),
            "reason": "cooldown_active",
            "detail": cooldown,
        })
        rejection_reasons.append({"reason": "cooldown_active", **cooldown})

    controls = cfg.get("canary_controls", {}) if isinstance(cfg.get("canary_controls"), dict) else {}
    safety_cfg = cfg.get("safety", {}) if isinstance(cfg.get("safety"), dict) else {}
    live_shell_armed = (
        (not bool(args.pending_only))
        and bool(args.allow_live)
        and bool(controls.get("live_order_placement_enabled", False))
        and bool(safety_cfg.get("trade_enabled", False))
        and not bool(safety_cfg.get("dry_run_only", True))
        and len(rejections) == 0
    )
    accepted = len(rejections) == 0
    basket_id = dryrun_mod.derive_basket_id(shadow_current)
    intentions = dryrun_mod.build_intention_rows(shadow_current, cfg, run_at_utc=run_at_utc) if accepted and not bool(args.pending_only) else []

    shell_state = dict(state)
    residual_flatten_history, residual_flatten_history_summary = _record_residual_flatten_history(
        shell_state=shell_state,
        residual_flatten_orders=[],
        exchange_reconciliation={},
        flatten_reason=shell_state.get("basket_flatten_reason"),
        run_at_utc=run_at_utc,
    )
    live_positions = shell_state.get("live_positions", []) if isinstance(shell_state.get("live_positions"), list) else []
    pending_entries = shell_state.get("pending_entries", []) if isinstance(shell_state.get("pending_entries"), list) else []
    closed_trades = shell_state.get("closed_trades", []) if isinstance(shell_state.get("closed_trades"), list) else []
    executed_order_rows: list[dict[str, Any]] = []
    bridge_warnings: list[dict[str, Any]] = []
    bridge_connected = False
    submit_stats = {
        "legs_attempted": 0,
        "legs_submitted": 0,
        "legs_submit_failed": 0,
        "legs_failed_post_only": 0,
    }
    leg_failures: list[dict[str, Any]] = []
    bridge_runtime_stats = {
        "managed_pending": 0,
        "moved_to_live": 0,
        "managed_live": 0,
        "closed_count": 0,
    }
    exchange_open_positions: list[dict[str, Any]] = []
    exchange_reconciliation = {
        "positions": [],
        "summary": {
            "exchange_open_count": 0,
            "claimed_by_local_state_count": 0,
            "close_conflict_residual_count": 0,
            "residual_open_on_exchange_count": 0,
            "claimed_by_local_state_symbols": [],
            "close_conflict_residual_symbols": [],
            "residual_open_on_exchange_symbols": [],
            "current_basket_claimed_exchange_count": 0,
            "current_basket_close_conflict_count": 0,
        },
    }
    pretrade_basket_safety = {
        "basket_id": None,
        "classification": "healthy",
        "block_new_entries": False,
        "flatten_required": False,
        "current_basket_status": "none",
        "current_basket_submitted_leg_count": 0,
        "current_basket_long_leg_count": 0,
        "current_basket_short_leg_count": 0,
        "reasons": [],
        "reconciliation_summary": exchange_reconciliation["summary"],
    }
    bridge = None
    phase3_cfg = cfg.get("phase3", {}) if isinstance(cfg.get("phase3"), dict) else {}
    phase6_cfg = cfg.get("phase6", {}) if isinstance(cfg.get("phase6"), dict) else {}
    exec_cfg = build_exec_cfg(cfg, intentions or pending_entries)
    current_config_version = phase6_mod.config_hash(exec_cfg)
    current_code_version = phase6_mod.code_version()
    fr_monitor_root = str(phase3_cfg.get("fr_monitor_root") or "").strip()
    should_sync_phase6_runtime = bool((live_shell_armed and intentions) or pending_entries or live_positions)
    should_collect_exchange_snapshot = bool(fr_monitor_root)

    if should_sync_phase6_runtime or should_collect_exchange_snapshot:
        try:
            bridge = phase6_mod.load_frmonitor_bridge(
                fr_monitor_root,
                local_private_path=phase3_cfg.get("local_private_path"),
            )
        except Exception as exc:
            bridge_warnings.append({
                "kind": "bridge_load_failed",
                "message": f"fr_monitor bridge load failed: {exc}",
                "detail": {
                    "fr_monitor_root": fr_monitor_root or None,
                    "error": str(exc),
                },
            })

    if bridge is not None:
        exchange_open_positions = collect_exchange_open_positions(bridge=bridge, cfg=cfg)

    existing_intentions = dryrun_mod.read_json(paths["intentions"], [])
    if not isinstance(existing_intentions, list):
        existing_intentions = []
    tracked_basket_id = choose_tracked_basket_id(
        current_basket_id=basket_id,
        pending_entries=pending_entries,
        live_positions=live_positions,
        closed_trades=closed_trades,
        leg_failures=leg_failures,
    )
    parity_current, parity_intentions = build_parity_current_for_basket(
        basket_id=tracked_basket_id,
        shadow_current=shadow_current,
        intentions=[*existing_intentions, *intentions],
    )

    exchange_reconciliation = reconcile_exchange_positions(
        basket_id=basket_id,
        exchange_positions=exchange_open_positions,
        pending_entries=pending_entries,
        live_positions=live_positions,
        closed_trades=closed_trades,
        order_rows=dryrun_mod.read_json(paths["orders"], []),
        now_utc=run_at_utc,
    )
    pretrade_basket_runtime = summarize_basket_runtime(
        basket_id=basket_id,
        bar_key=shadow_current.get("bar_key"),
        decision_ts=shadow_current.get("decision_ts"),
        planned_exit_ts=shadow_current.get("planned_exit_ts"),
        official_window=official_window,
        state=shell_state,
        live_positions=live_positions,
        pending_entries=pending_entries,
        closed_trades=closed_trades,
        live_shell_armed=live_shell_armed,
        bridge_connected=bridge_connected,
        submit_stats=submit_stats,
        exchange_positions=exchange_reconciliation["positions"],
        exchange_reconciliation=exchange_reconciliation,
    )
    pretrade_basket_safety = classify_basket_safety(
        basket_id=basket_id,
        basket_runtime=pretrade_basket_runtime,
        basket_parity={"submitted_basket": {"symbol_count": 0}, "realized_basket": {"lifecycle": []}},
        reconciliation=exchange_reconciliation,
        cfg=cfg,
    )
    has_active_basket = bool(pending_entries or live_positions)
    if bridge is not None and has_active_basket:
        pending_entries, live_positions, closed_trades, runtime_orders, runtime_warnings, bridge_runtime_stats = sync_phase6_runtime(
            bridge=bridge,
            cfg=cfg,
            paths=paths,
            shell_state=shell_state,
            pending_entries=pending_entries,
            live_positions=live_positions,
            closed_trades=closed_trades,
            run_at_utc=run_at_utc,
            metadata_rows=[*existing_intentions, *intentions, *pending_entries, *live_positions, *closed_trades],
            manage_live_positions=not bool(args.pending_only),
        )
        if runtime_orders:
            executed_order_rows.extend(runtime_orders)
        for warning in runtime_warnings:
            bridge_warnings.append({
                "kind": "phase6_runtime_warning",
                "message": str(warning.get("message") or "phase6_runtime_warning"),
                "detail": warning,
            })
        if pending_entries or live_positions or closed_trades:
            bridge_connected = True
        exchange_open_positions = collect_exchange_open_positions(bridge=bridge, cfg=cfg)
        exchange_reconciliation = reconcile_exchange_positions(
            basket_id=basket_id,
            exchange_positions=exchange_open_positions,
            pending_entries=pending_entries,
            live_positions=live_positions,
            closed_trades=closed_trades,
            order_rows=dryrun_mod.read_json(paths["orders"], []),
        )
        pretrade_basket_runtime = summarize_basket_runtime(
            basket_id=basket_id,
            bar_key=shadow_current.get("bar_key"),
            decision_ts=shadow_current.get("decision_ts"),
            planned_exit_ts=shadow_current.get("planned_exit_ts"),
            official_window=official_window,
            state=shell_state,
            live_positions=live_positions,
            pending_entries=pending_entries,
            closed_trades=closed_trades,
            live_shell_armed=live_shell_armed,
            bridge_connected=bridge_connected,
            submit_stats=submit_stats,
            exchange_positions=exchange_reconciliation["positions"],
            exchange_reconciliation=exchange_reconciliation,
        )
        pretrade_basket_safety = classify_basket_safety(
            basket_id=basket_id,
            basket_runtime=pretrade_basket_runtime,
            basket_parity={"submitted_basket": {"symbol_count": 0}, "realized_basket": {"lifecycle": []}},
            reconciliation=exchange_reconciliation,
            cfg=cfg,
        )
        has_active_basket = bool(pending_entries or live_positions)
    active_detail = None
    if not has_active_basket:
        rejections = [row for row in rejections if str(row.get("reason") or "") != "active_basket_exists"]
        rejection_reasons = [row for row in rejection_reasons if str(row.get("reason") or "") != "active_basket_exists"]
        accepted = len(rejections) == 0
        live_shell_armed = (
            (not bool(args.pending_only))
            and bool(args.allow_live)
            and bool(controls.get("live_order_placement_enabled", False))
            and bool(safety_cfg.get("trade_enabled", False))
            and not bool(safety_cfg.get("dry_run_only", True))
            and accepted
        )
        if accepted and not bool(args.pending_only):
            intentions = dryrun_mod.build_intention_rows(shadow_current, cfg, run_at_utc=run_at_utc)
    else:
        raw_active_symbols = sorted({str(row.get("symbol") or "") for row in [*pending_entries, *live_positions] if str(row.get("symbol") or "")})
        active_basket_ids = sorted({str(row.get("basket_id") or "") for row in [*pending_entries, *live_positions] if str(row.get("basket_id") or "")})
        active_basket_id = active_basket_ids[0] if len(active_basket_ids) == 1 else None
        active_submit_stats = derive_submit_stats_for_basket(
            basket_id=active_basket_id,
            intentions=[*existing_intentions, *intentions],
            pending_entries=pending_entries,
            live_positions=live_positions,
            closed_trades=closed_trades,
            orders=dryrun_mod.read_json(paths["orders"], []),
            leg_failures=leg_failures,
        ) if active_basket_id else {}
        active_runtime = summarize_basket_runtime(
            basket_id=active_basket_id,
            bar_key=(pretrade_basket_runtime or {}).get("bar_key"),
            decision_ts=(pretrade_basket_runtime or {}).get("decision_ts"),
            planned_exit_ts=(pretrade_basket_runtime or {}).get("planned_exit_ts"),
            official_window=(pretrade_basket_runtime or {}).get("entry_window") or official_window,
            state=shell_state,
            live_positions=live_positions,
            pending_entries=pending_entries,
            closed_trades=closed_trades,
            live_shell_armed=False,
            bridge_connected=bridge_connected,
            submit_stats=active_submit_stats,
            exchange_positions=exchange_reconciliation.get("positions", []),
            exchange_reconciliation=exchange_reconciliation,
            basket_safety=pretrade_basket_safety,
        ) if active_basket_id else None
        active_symbols = list(raw_active_symbols)
        active_pending_count = len(pending_entries)
        active_live_count = len(live_positions)
        if active_runtime:
            active_symbols = sorted({
                str(symbol or "")
                for symbol in [
                    *(active_runtime.get("pending_entry_symbols") or []),
                    *(active_runtime.get("live_symbols") or []),
                ]
                if str(symbol or "")
            })
            active_pending_count = int(active_runtime.get("legs_pending", active_pending_count) or 0)
            active_live_count = int(active_runtime.get("legs_live", active_live_count) or 0)
        active_detail = {
            "active_basket_ids": active_basket_ids,
            "active_symbols": active_symbols,
            "pending_count": active_pending_count,
            "live_count": active_live_count,
            "pending_entry_count": active_pending_count,
            "live_position_count": active_live_count,
        }
        if active_runtime:
            active_detail.update({
                "basket_id": active_runtime.get("basket_id"),
                "basket_status": active_runtime.get("basket_status"),
                "pending_entry_count": int(active_runtime.get("legs_pending", len(pending_entries)) or 0),
                "live_position_count": int(active_runtime.get("legs_live", len(live_positions)) or 0),
                "closed_position_count": int(active_runtime.get("legs_closed", 0) or 0),
                "legs_submitted": int(active_runtime.get("legs_submitted", 0) or 0),
                "legs_submit_failed": int(active_runtime.get("legs_submit_failed", 0) or 0),
            })
        if any(str(row.get("reason") or "") == "active_basket_exists" for row in rejection_reasons):
            rejections = [
                ({**row, "detail": active_detail} if str(row.get("reason") or "") == "active_basket_exists" else row)
                for row in rejections
            ]
            rejection_reasons = [
                ({"reason": "active_basket_exists", **active_detail} if str(row.get("reason") or "") == "active_basket_exists" else row)
                for row in rejection_reasons
            ]
    if bool(controls.get("max_one_basket_at_a_time", True)) and accepted and has_active_basket and active_detail is not None:
        rejections.append({
            "timestamp": run_at_utc,
            "bar_key": shadow_current.get("bar_key"),
            "reason": "active_basket_exists",
            "detail": active_detail,
        })
        rejection_reasons.append({"reason": "active_basket_exists", **active_detail})
        accepted = False
        live_shell_armed = False
        intentions = []
    if pretrade_basket_safety.get("block_new_entries"):
        safety_detail = {
            "classification": pretrade_basket_safety.get("classification"),
            "flatten_required": bool(pretrade_basket_safety.get("flatten_required", False)),
            "reasons": pretrade_basket_safety.get("reasons", []),
        }
        rejections.append({
            "timestamp": run_at_utc,
            "bar_key": shadow_current.get("bar_key"),
            "reason": "basket_safety_blocked_pretrade",
            "detail": safety_detail,
        })
        rejection_reasons.append({"reason": "basket_safety_blocked_pretrade", **safety_detail})
        bridge_warnings.append({
            "kind": "basket_safety_blocked_pretrade",
            "message": f"basket safety blocked new entries: {pretrade_basket_safety.get('classification')}",
            "detail": safety_detail,
        })
        accepted = False
        live_shell_armed = False
        intentions = []

    if live_shell_armed and intentions and bridge is not None:
        run_ctx = phase6_mod.RunContext(now_iso=run_at_utc, now_dt=pd.to_datetime(run_at_utc, utc=True).to_pydatetime())
        basket_pending_rows: list[dict[str, Any]] = []
        for intention in intentions:
            submit_stats["legs_attempted"] += 1
            trace_id = phase6_mod.make_trace_id(str(intention.get("intention_id") or intention.get("symbol") or "rank213-basket"))
            try:
                entry_result = build_pending_entry_row(
                    bridge,
                    cfg,
                    phase6_cfg,
                    intention,
                    run_at_utc=run_at_utc,
                    run_dt=run_ctx.now_dt,
                    trace_id=trace_id,
                    current_config_version=current_config_version,
                    current_code_version=current_code_version,
                )
                pending_row = dict(entry_result.get("pending_row") or {})
                live_row = dict(entry_result.get("live_row") or {})
                order_row = dict(entry_result.get("order_row") or {})
                order_rows = [
                    dict(row) for row in (entry_result.get("order_rows") or [])
                    if isinstance(row, dict)
                ]
                leverage_guard = dict(entry_result.get("leverage_guard") or {})
                fallback_used = bool(entry_result.get("fallback_used", False))
                if pending_row:
                    basket_pending_rows.append(pending_row)
                if live_row:
                    live_positions.append(live_row)
                submit_stats["legs_submitted"] += 1
                if fallback_used:
                    submit_stats["legs_failed_post_only"] += 1
                if order_rows:
                    executed_order_rows.extend(order_rows)
                elif order_row:
                    executed_order_rows.append(order_row)
                executed_order_rows.append({
                    "timestamp": run_at_utc,
                    "basket_id": basket_id,
                    "basket_role": intention.get("basket_role"),
                    "symbol": intention.get("symbol"),
                    "side": intention.get("side"),
                    "order_role": "leverage_guard",
                    "order_type": "CONFIG",
                    "price": None,
                    "qty": None,
                    "status": "VERIFIED",
                    "exchange_order_id": None,
                    "client_order_id": None,
                    "payload": leverage_guard,
                })
            except Exception as exc:
                failure_reason, error_text = classify_bridge_entry_failure(exc)
                submit_stats["legs_submit_failed"] += 1
                if failure_reason == "maker_rejected_post_only":
                    submit_stats["legs_failed_post_only"] += 1
                failure_detail = {
                    "symbol": intention.get("symbol"),
                    "side": intention.get("side"),
                    "basket_role": intention.get("basket_role"),
                    "basket_id": intention.get("basket_id"),
                    "error": error_text,
                }
                leg_failures.append({"reason": failure_reason, **failure_detail})
                bridge_warnings.append({"kind": failure_reason, "message": f"{intention.get('symbol')}: {error_text}", "detail": failure_detail})
                rejections.append({
                    "timestamp": run_at_utc,
                    "bar_key": shadow_current.get("bar_key"),
                    "reason": failure_reason,
                    "detail": failure_detail,
                })
                rejection_reasons.append({"reason": failure_reason, **failure_detail})
                continue
        if basket_pending_rows:
            pending_entries = pending_entries + basket_pending_rows
            bridge_connected = True
        elif submit_stats["legs_attempted"] > 0:
            live_shell_armed = False
        basket_submit_stats = derive_submit_stats_for_basket(
            basket_id=basket_id,
            intentions=intentions,
            pending_entries=pending_entries,
            live_positions=live_positions,
            closed_trades=closed_trades,
            orders=executed_order_rows,
            leg_failures=leg_failures,
        )
        submit_stats.update({
            "legs_attempted": int(basket_submit_stats.get("legs_attempted", submit_stats.get("legs_attempted", 0))),
            "legs_submitted": int(basket_submit_stats.get("legs_submitted", submit_stats.get("legs_submitted", 0))),
            "legs_submit_failed": int(basket_submit_stats.get("legs_submit_failed", submit_stats.get("legs_submit_failed", 0))),
            "legs_failed_post_only": int(basket_submit_stats.get("legs_failed_post_only", submit_stats.get("legs_failed_post_only", 0))),
            "legs_materialized": int(basket_submit_stats.get("legs_materialized", 0)),
            "legs_unmaterialized": int(basket_submit_stats.get("legs_unmaterialized", 0)),
            "materialized_symbol_count": int(basket_submit_stats.get("materialized_symbol_count", 0)),
            "materialized_symbols": list(basket_submit_stats.get("materialized_symbols", [])),
            "unmaterialized_symbols": list(basket_submit_stats.get("unmaterialized_symbols", [])),
            "basket_comparable": bool(basket_submit_stats.get("basket_comparable", False)),
        })

    if bridge is not None:
        exchange_open_positions = collect_exchange_open_positions(bridge=bridge, cfg=cfg)

    exchange_reconciliation = reconcile_exchange_positions(
        basket_id=basket_id,
        exchange_positions=exchange_open_positions,
        pending_entries=pending_entries,
        live_positions=live_positions,
        closed_trades=closed_trades,
        order_rows=dryrun_mod.read_json(paths["orders"], []),
        now_utc=run_at_utc,
    )
    pretrade_basket_runtime = summarize_basket_runtime(
        basket_id=basket_id,
        bar_key=shadow_current.get("bar_key"),
        decision_ts=shadow_current.get("decision_ts"),
        planned_exit_ts=shadow_current.get("planned_exit_ts"),
        official_window=official_window,
        state=shell_state,
        live_positions=live_positions,
        pending_entries=pending_entries,
        closed_trades=closed_trades,
        live_shell_armed=live_shell_armed,
        bridge_connected=bridge_connected,
        submit_stats=submit_stats,
        exchange_positions=exchange_reconciliation["positions"],
        exchange_reconciliation=exchange_reconciliation,
    )
    pretrade_basket_safety = classify_basket_safety(
        basket_id=basket_id,
        basket_runtime=pretrade_basket_runtime,
        basket_parity={"submitted_basket": {"symbol_count": 0}, "realized_basket": {"lifecycle": []}},
        reconciliation=exchange_reconciliation,
        cfg=cfg,
    )
    if pretrade_basket_safety.get("block_new_entries"):
        safety_detail = {
            "classification": pretrade_basket_safety.get("classification"),
            "flatten_required": bool(pretrade_basket_safety.get("flatten_required", False)),
            "reasons": pretrade_basket_safety.get("reasons", []),
        }
        rejections.append({
            "timestamp": run_at_utc,
            "bar_key": shadow_current.get("bar_key"),
            "reason": "basket_safety_blocked_pretrade",
            "detail": safety_detail,
        })
        rejection_reasons.append({"reason": "basket_safety_blocked_pretrade", **safety_detail})
        bridge_warnings.append({
            "kind": "basket_safety_blocked_pretrade",
            "message": f"basket safety blocked new entries: {pretrade_basket_safety.get('classification')}",
            "detail": safety_detail,
        })
        accepted = False
        live_shell_armed = False
        intentions = []
    dryrun_mod.save_json(paths["exchange_positions"], exchange_reconciliation["positions"])

    pretrade_accepted = accepted
    accepted = bool(pretrade_accepted and official_window.get("eligible", False))
    orders = executed_order_rows if (bridge_connected or executed_order_rows) else build_preview_orders(intentions, cfg, run_at_utc=run_at_utc, live_shell_armed=live_shell_armed, basket_id=basket_id)
    if not orders:
        orders = reconstruct_order_history(
            pending_entries=pending_entries,
            live_positions=live_positions,
            closed_trades=closed_trades,
        )
    warnings.extend(bridge_warnings)

    merged_intentions = dryrun_mod.append_recent_json(paths["intentions"], intentions, tail=120, key_fields=["intention_id"])
    merged_rejections = dryrun_mod.append_recent_json(paths["rejections"], rejections, tail=180, key_fields=["bar_key", "reason"])
    merged_orders = dryrun_mod.append_recent_json(
        paths["orders"],
        orders,
        tail=400,
        key_fields=["timestamp", "basket_id", "intention_id", "symbol", "order_role", "client_order_id", "exchange_order_id"],
    )
    if isinstance(merged_orders, list):
        orders = merged_orders
    dryrun_mod.save_json(paths["warnings"], warnings)

    write_compare_csv(paths["compare"], run_at_utc=run_at_utc, current=shadow_current, accepted=accepted, rejection_reasons=rejection_reasons, basket_metrics=basket_metrics, live_shell_armed=live_shell_armed, official_window=official_window, submit_stats=submit_stats)
    tracked_basket_id = choose_tracked_basket_id(
        current_basket_id=basket_id,
        pending_entries=pending_entries,
        live_positions=live_positions,
        closed_trades=closed_trades,
        leg_failures=leg_failures,
    )
    tracked_parity_current, tracked_parity_intentions = build_parity_current_for_basket(
        basket_id=tracked_basket_id,
        shadow_current=shadow_current,
        intentions=[*existing_intentions, *intentions],
    )
    tracked_exchange_reconciliation = exchange_reconciliation
    if tracked_basket_id and tracked_basket_id != basket_id:
        tracked_exchange_reconciliation = reconcile_exchange_positions(
            basket_id=tracked_basket_id,
            exchange_positions=exchange_open_positions,
            pending_entries=pending_entries,
            live_positions=live_positions,
            closed_trades=closed_trades,
            order_rows=orders,
            now_utc=run_at_utc,
        )
    tracked_basket_pending = [row for row in pending_entries if str(row.get("basket_id") or "") == str(tracked_basket_id or "")]
    tracked_basket_live = [row for row in live_positions if str(row.get("basket_id") or "") == str(tracked_basket_id or "")]
    tracked_basket_closed = [row for row in closed_trades if str(row.get("basket_id") or "") == str(tracked_basket_id or "")]
    tracked_submit_stats = derive_submit_stats_for_basket(
        basket_id=tracked_basket_id,
        intentions=[*existing_intentions, *intentions],
        pending_entries=pending_entries,
        live_positions=live_positions,
        closed_trades=closed_trades,
        orders=orders,
        leg_failures=leg_failures,
    )
    fallback_taker_count = len([row for row in orders if str(row.get("order_role") or "") == "entry_fallback" and str(row.get("basket_id") or "") == str(tracked_basket_id or "")])
    tracked_leg_failures = [
        row for row in leg_failures
        if isinstance(row, dict) and str(row.get("basket_id") or "") == str(tracked_basket_id or "")
    ]
    tracked_rejected_post_only_symbols = {
        str(row.get("symbol") or "").upper()
        for row in orders
        if isinstance(row, dict)
        and str(row.get("basket_id") or "") == str(tracked_basket_id or "")
        and str(row.get("order_role") or "") == "entry_rejected_post_only"
        and row.get("symbol")
    }
    tracked_fallback_taker_symbols = {
        str(row.get("symbol") or "").upper()
        for row in orders
        if isinstance(row, dict)
        and str(row.get("basket_id") or "") == str(tracked_basket_id or "")
        and str(row.get("order_role") or "") == "entry_fallback"
        and row.get("symbol")
    }
    if not tracked_leg_failures and tracked_submit_stats.get("legs_submit_failed", 0) > 0:
        intended_symbols = {
            str(row.get("symbol") or "").upper()
            for row in tracked_parity_intentions
            if isinstance(row, dict) and row.get("symbol")
        }
        realized_symbols = {
            str(row.get("symbol") or "").upper()
            for row in [*tracked_basket_pending, *tracked_basket_live, *tracked_basket_closed]
            if isinstance(row, dict) and row.get("symbol")
        }
        tracked_leg_failures = [
            {
                "reason": "maker_rejected_post_only" if symbol in tracked_rejected_post_only_symbols else "submit_failed",
                "symbol": symbol,
                "basket_id": tracked_basket_id,
            }
            for symbol in sorted(intended_symbols - realized_symbols)
        ]
    tracked_submit_stats["legs_failed_post_only"] = max(
        int(tracked_submit_stats.get("legs_failed_post_only", 0)),
        sum(1 for row in tracked_leg_failures if str(row.get("reason") or "") == "maker_rejected_post_only"),
        len(tracked_rejected_post_only_symbols),
    )
    tracked_submit_stats["require_complete_basket"] = bool(cfg.get("basket_controls", {}).get("require_complete_basket", False))
    tracked_basket_parity = dryrun_mod.build_basket_parity_payload(
        current=tracked_parity_current or shadow_current,
        basket_metrics=basket_metrics if tracked_basket_id == basket_id else ((tracked_parity_current or {}).get("basket_metrics") or {}),
        intentions=tracked_parity_intentions,
        submitted_rows=tracked_basket_pending,
        live_rows=tracked_basket_live,
        closed_rows=tracked_basket_closed,
        leg_failures=tracked_leg_failures,
        submit_stats=tracked_submit_stats,
        fallback_taker_count=fallback_taker_count,
        maker_reject_symbols=sorted(tracked_rejected_post_only_symbols),
        fallback_taker_symbols=sorted(tracked_fallback_taker_symbols),
        suppression_reasons=rejection_reasons if tracked_basket_id == basket_id else [],
        exchange_positions=tracked_exchange_reconciliation["positions"],
    )
    latest_basket_pending = [row for row in pending_entries if str(row.get("basket_id") or "") == str(basket_id or "")]
    latest_basket_live = [row for row in live_positions if str(row.get("basket_id") or "") == str(basket_id or "")]
    latest_basket_closed = [row for row in closed_trades if str(row.get("basket_id") or "") == str(basket_id or "")]
    latest_submit_stats = derive_submit_stats_for_basket(
        basket_id=basket_id,
        intentions=[*existing_intentions, *intentions],
        pending_entries=pending_entries,
        live_positions=live_positions,
        closed_trades=closed_trades,
        orders=orders,
        leg_failures=leg_failures,
    )
    latest_fallback_taker_count = len([row for row in orders if str(row.get("order_role") or "") == "entry_fallback" and str(row.get("basket_id") or "") == str(basket_id or "")])
    latest_rejected_post_only_symbols = {
        str(row.get("symbol") or "").upper()
        for row in orders
        if isinstance(row, dict)
        and str(row.get("basket_id") or "") == str(basket_id or "")
        and str(row.get("order_role") or "") == "entry_rejected_post_only"
        and row.get("symbol")
    }
    latest_fallback_taker_symbols = {
        str(row.get("symbol") or "").upper()
        for row in orders
        if isinstance(row, dict)
        and str(row.get("basket_id") or "") == str(basket_id or "")
        and str(row.get("order_role") or "") == "entry_fallback"
        and row.get("symbol")
    }
    latest_leg_failures = [
        row for row in leg_failures
        if isinstance(row, dict) and str(row.get("basket_id") or "") == str(basket_id or "")
    ]
    if not latest_leg_failures and latest_submit_stats.get("legs_submit_failed", 0) > 0:
        intended_symbols = {
            str(row.get("symbol") or "").upper()
            for row in intentions
            if isinstance(row, dict) and row.get("symbol")
        }
        realized_symbols = {
            str(row.get("symbol") or "").upper()
            for row in [*latest_basket_pending, *latest_basket_live, *latest_basket_closed]
            if isinstance(row, dict) and row.get("symbol")
        }
        latest_leg_failures = [
            {
                "reason": "maker_rejected_post_only" if symbol in latest_rejected_post_only_symbols else "submit_failed",
                "symbol": symbol,
                "basket_id": basket_id,
            }
            for symbol in sorted(intended_symbols - realized_symbols)
        ]
    latest_submit_stats["legs_failed_post_only"] = max(
        int(latest_submit_stats.get("legs_failed_post_only", 0)),
        sum(1 for row in latest_leg_failures if str(row.get("reason") or "") == "maker_rejected_post_only"),
        len(latest_rejected_post_only_symbols),
    )
    latest_submit_stats["require_complete_basket"] = bool(cfg.get("basket_controls", {}).get("require_complete_basket", False))
    latest_basket_parity = dryrun_mod.build_basket_parity_payload(
        current=shadow_current,
        basket_metrics=basket_metrics,
        intentions=intentions,
        submitted_rows=latest_basket_pending,
        live_rows=latest_basket_live,
        closed_rows=latest_basket_closed,
        leg_failures=latest_leg_failures,
        submit_stats=latest_submit_stats,
        fallback_taker_count=latest_fallback_taker_count,
        maker_reject_symbols=sorted(latest_rejected_post_only_symbols),
        fallback_taker_symbols=sorted(latest_fallback_taker_symbols),
        suppression_reasons=rejection_reasons,
        exchange_positions=exchange_reconciliation["positions"],
    )
    provisional_basket_runtime = summarize_basket_runtime(
        basket_id=basket_id,
        bar_key=shadow_current.get("bar_key"),
        decision_ts=shadow_current.get("decision_ts"),
        planned_exit_ts=shadow_current.get("planned_exit_ts"),
        official_window=official_window,
        state=shell_state,
        live_positions=live_positions,
        pending_entries=pending_entries,
        closed_trades=closed_trades,
        live_shell_armed=live_shell_armed,
        bridge_connected=bridge_connected,
        submit_stats=submit_stats,
        exchange_positions=exchange_reconciliation["positions"],
    )
    basket_safety = classify_basket_safety(
        basket_id=basket_id,
        basket_runtime=provisional_basket_runtime,
        basket_parity=latest_basket_parity,
        reconciliation=exchange_reconciliation,
        cfg=cfg,
    )
    quarantine_flatten_reason = None
    flattened_live_count = 0
    flattened_residual_count = 0
    residual_flatten_orders: list[dict[str, Any]] = []
    residual_flatten_results: list[dict[str, Any]] = []
    if bool(basket_safety.get("flatten_required", False)):
        reasons = basket_safety.get("reasons", []) if isinstance(basket_safety.get("reasons"), list) else []
        quarantine_flatten_reason = reasons[0].get("reason") if reasons and isinstance(reasons[0], dict) else "basket_safety_flatten_required"
        live_shell_armed = False
        if bridge is not None and live_positions:
            live_positions, flatten_orders, flatten_closed, flatten_warnings, flattened_live_count = rank213_flatten_positions(
                bridge=bridge,
                positions=live_positions,
                reason=quarantine_flatten_reason,
                run_at_utc=run_at_utc,
                paths=paths,
            )
            if flatten_orders:
                executed_order_rows.extend(flatten_orders)
            if flatten_closed:
                closed_trades.extend(flatten_closed)
            if flatten_warnings:
                for warning in flatten_warnings:
                    bridge_warnings.append({
                        "kind": "rank213_flatten_warning",
                        "message": str(warning.get("message") or "rank213_flatten_warning"),
                        "detail": warning,
                    })
            if flattened_live_count > 0:
                bridge_connected = True
    residual_flatten_needed = int(exchange_reconciliation.get("summary", {}).get("close_conflict_residual_count", 0) or 0) > 0
    if bridge is not None and not live_positions and residual_flatten_needed:
        residual_flatten_reason = "close_conflict_residual"
        residual_flatten_orders, residual_flatten_warnings, flattened_residual_count, residual_flatten_results = rank213_flatten_exchange_residuals(
            bridge=bridge,
            exchange_positions=exchange_reconciliation["positions"],
            reason=residual_flatten_reason,
            run_at_utc=run_at_utc,
            paths=paths,
        )
        if residual_flatten_orders:
            executed_order_rows.extend(residual_flatten_orders)
            bridge_connected = True
            if quarantine_flatten_reason is None:
                quarantine_flatten_reason = residual_flatten_reason
        if residual_flatten_warnings:
            for warning in residual_flatten_warnings:
                bridge_warnings.append({
                    "kind": "rank213_residual_flatten_warning",
                    "message": str(warning.get("message") or "rank213_residual_flatten_warning"),
                    "detail": warning,
                })
    residual_flatten_history, residual_flatten_history_summary = _record_residual_flatten_history(
        shell_state=shell_state,
        residual_flatten_orders=residual_flatten_orders,
        exchange_reconciliation=exchange_reconciliation,
        flatten_reason=quarantine_flatten_reason,
        run_at_utc=run_at_utc,
    )
    current_decision_basket_comparable = bool(submit_stats.get("basket_comparable", False))
    current_decision_comparability_classification = (
        "comparable" if current_decision_basket_comparable else "incomplete_non_comparable"
    )
    current_decision_audit = {
        "bar_key": shadow_current.get("bar_key"),
        "decision_ts": shadow_current.get("decision_ts"),
        "decision": shadow_current.get("decision"),
        "gate_on": shadow_current.get("gate_on"),
        "official_entry_window": official_window,
        "basket_metrics": basket_metrics,
        "accepted": accepted,
        "pretrade_accepted": pretrade_accepted,
        "live_shell_armed": live_shell_armed,
        "basket_comparable": current_decision_basket_comparable,
        "comparability_classification": current_decision_comparability_classification,
        "materialized_leg_count": int(submit_stats.get("legs_materialized", 0) or 0),
        "unmaterialized_leg_count": int(submit_stats.get("legs_unmaterialized", 0) or 0),
        "unmaterialized_symbols": submit_stats.get("unmaterialized_symbols", []),
        "incomplete_basket": bool(int(submit_stats.get("legs_unmaterialized", 0) or 0) > 0),
        "rejections": list({json.dumps(row, sort_keys=True, ensure_ascii=False): row for row in rejection_reasons}.values()),
    }
    tracked_exchange_reconciliation = exchange_reconciliation
    if tracked_basket_id and tracked_basket_id != basket_id:
        tracked_exchange_reconciliation = reconcile_exchange_positions(
            basket_id=tracked_basket_id,
            exchange_positions=exchange_open_positions,
            pending_entries=pending_entries,
            live_positions=live_positions,
            closed_trades=closed_trades,
            order_rows=orders,
            now_utc=run_at_utc,
        )
    tracked_basket_safety = basket_safety if tracked_basket_id == basket_id else classify_basket_safety(
        basket_id=tracked_basket_id,
        basket_runtime=summarize_basket_runtime(
            basket_id=tracked_basket_id,
            bar_key=(tracked_parity_current or {}).get("bar_key"),
            decision_ts=(tracked_parity_current or {}).get("decision_ts"),
            planned_exit_ts=(tracked_parity_current or {}).get("planned_exit_ts"),
            official_window=official_window,
            state=shell_state,
            live_positions=tracked_basket_live,
            pending_entries=tracked_basket_pending,
            closed_trades=tracked_basket_closed,
            live_shell_armed=False,
            bridge_connected=bridge_connected,
            submit_stats=tracked_submit_stats,
            exchange_positions=tracked_exchange_reconciliation["positions"],
            exchange_reconciliation=tracked_exchange_reconciliation,
        ),
        basket_parity=tracked_basket_parity,
        reconciliation=tracked_exchange_reconciliation,
        cfg=cfg,
    )
    tracked_basket_outcome = {
        "basket_id": tracked_basket_id,
        "basket_parity": tracked_basket_parity,
        "basket_safety": tracked_basket_safety,
        "basket_comparable": bool((tracked_basket_safety or {}).get("basket_comparable", False)),
        "comparability_classification": str((tracked_basket_safety or {}).get("comparability_classification") or "incomplete_non_comparable"),
        "materialized_leg_count": int((tracked_basket_safety or {}).get("materialized_leg_count", tracked_submit_stats.get("legs_materialized", 0)) or 0),
        "unmaterialized_leg_count": int((tracked_basket_safety or {}).get("unmaterialized_leg_count", tracked_submit_stats.get("legs_unmaterialized", 0)) or 0),
        "unmaterialized_symbols": tracked_submit_stats.get("unmaterialized_symbols", []),
        "incomplete_basket": bool(int(tracked_submit_stats.get("legs_unmaterialized", 0) or 0) > 0),
        "exchange_reconciliation": tracked_exchange_reconciliation,
        "residual_flatten_history": residual_flatten_history,
        "residual_flatten_history_summary": residual_flatten_history_summary,
    }
    compare_summary = {
        "generated_at_utc": run_at_utc,
        "scope": "rank213 live shell current decision audit + tracked basket outcome",
        "accepted": accepted,
        "pretrade_accepted": pretrade_accepted,
        "live_shell_armed": live_shell_armed,
        "rejection_count": len(rejections),
        "intentions_created": len(intentions),
        "orders_recorded": len(orders),
        "shadow_bar_key": shadow_current.get("bar_key"),
        "shadow_decision": shadow_current.get("decision"),
        "shadow_gate_on": shadow_current.get("gate_on"),
        "official_entry_window": official_window,
        "basket_metrics": basket_metrics,
        "execution_audit": {
            "mode": "rank213_horizon_runtime" if bridge_connected else "guarded_shell",
            "bridge_connected": bridge_connected,
            "bridge_default_off": True,
            "maker_first_configured": bool(cfg.get("execution", {}).get("maker_first", True)),
            "fallback_to_taker_configured": bool(cfg.get("phase6", {}).get("entry", {}).get("fallback_to_market_on_ttl", True)),
            "preview_signal": bool(shadow_current.get("is_preview", False)),
            "maker_fill_count": 0,
            "maker_reject_count": submit_stats.get("legs_failed_post_only", 0),
            "fallback_taker_count": latest_fallback_taker_count,
            "legs_attempted": submit_stats.get("legs_attempted", 0),
            "legs_submitted": submit_stats.get("legs_submitted", 0),
            "legs_submit_failed": submit_stats.get("legs_submit_failed", 0),
            "legs_materialized": submit_stats.get("legs_materialized", 0),
            "legs_unmaterialized": submit_stats.get("legs_unmaterialized", 0),
            "unmaterialized_symbols": submit_stats.get("unmaterialized_symbols", []),
            "partial_basket_count": 1 if submit_stats.get("legs_unmaterialized", 0) > 0 and submit_stats.get("legs_materialized", 0) > 0 else 0,
            "missed_leg_count": max(0, int(submit_stats.get("legs_attempted", 0)) - int(submit_stats.get("legs_materialized", 0))),
            "basket_comparable": current_decision_basket_comparable,
            "comparability_classification": current_decision_comparability_classification,
            "incomplete_basket": bool(int(submit_stats.get("legs_unmaterialized", 0) or 0) > 0),
            "managed_pending": bridge_runtime_stats.get("managed_pending", 0),
            "moved_to_live": bridge_runtime_stats.get("moved_to_live", 0),
            "managed_live": bridge_runtime_stats.get("managed_live", 0),
            "closed_count": bridge_runtime_stats.get("closed_count", 0),
            "flattened_live_count": flattened_live_count,
            "flattened_residual_count": flattened_residual_count,
            "residual_flatten_history": residual_flatten_history_summary,
        },
        "current_decision_audit": current_decision_audit,
        "tracked_basket_outcome": tracked_basket_outcome,
        "current_basket_parity": latest_basket_parity,
        "tracked_basket_parity": tracked_basket_parity if tracked_basket_id else None,
        "basket_parity": latest_basket_parity,
        "exchange_reconciliation": exchange_reconciliation,
        "basket_safety": basket_safety,
        "residual_flatten_results": residual_flatten_results,
        "residual_flatten_history": residual_flatten_history,
        "residual_flatten_history_summary": residual_flatten_history_summary,
    }
    dryrun_mod.save_json(paths["compare_summary"], compare_summary)

    runtime_state = dict(shell_state)
    if quarantine_flatten_reason:
        runtime_state["basket_flatten_reason"] = quarantine_flatten_reason
    basket_runtime = summarize_basket_runtime(
        basket_id=basket_id,
        bar_key=shadow_current.get("bar_key"),
        decision_ts=shadow_current.get("decision_ts"),
        planned_exit_ts=shadow_current.get("planned_exit_ts"),
        official_window=official_window,
        state=runtime_state,
        live_positions=live_positions,
        pending_entries=pending_entries,
        closed_trades=closed_trades,
        live_shell_armed=live_shell_armed,
        bridge_connected=bridge_connected,
        submit_stats=submit_stats,
        exchange_positions=exchange_reconciliation["positions"],
        exchange_reconciliation=exchange_reconciliation,
        basket_safety=basket_safety,
    )
    basket_status = "flattening" if quarantine_flatten_reason else basket_runtime.get("basket_status")
    if quarantine_flatten_reason and isinstance(basket_runtime, dict):
        basket_runtime["basket_status"] = "flattening"
        basket_runtime["flatten_reason"] = quarantine_flatten_reason
    elif isinstance(basket_runtime, dict):
        basket_runtime["flatten_reason"] = None

    event_kind = "live_shell_armed" if live_shell_armed else (
        "live_shell_flattening" if quarantine_flatten_reason else (
            "live_shell_incomplete_non_comparable"
            if int(submit_stats.get("legs_unmaterialized", 0) or 0) > 0
            else ("live_shell_partial_submit" if submit_stats.get("legs_submitted", 0) > 0 else ("live_shell_preview_ready" if accepted else "live_shell_rejected"))
        )
    )
    event = {
        "event_at_utc": run_at_utc,
        "runner": "rank213_live_canary_shell",
        "event_kind": event_kind,
        "bar_key": shadow_current.get("bar_key"),
        "decision_ts": shadow_current.get("decision_ts"),
        "accepted": accepted,
        "pretrade_accepted": pretrade_accepted,
        "live_shell_armed": live_shell_armed,
        "basket_id": basket_id,
        "basket_status": basket_status,
        "basket_comparable": current_decision_basket_comparable,
        "comparability_classification": current_decision_comparability_classification,
        "incomplete_basket": bool(int(submit_stats.get("legs_unmaterialized", 0) or 0) > 0),
        "materialized_leg_count": int(submit_stats.get("legs_materialized", 0) or 0),
        "unmaterialized_leg_count": int(submit_stats.get("legs_unmaterialized", 0) or 0),
        "unmaterialized_symbols": submit_stats.get("unmaterialized_symbols", []),
        "orders_recorded": len(orders),
        "submit_stats": submit_stats,
        "basket_safety": basket_safety,
        "residual_flatten_history_summary": residual_flatten_history_summary,
        "rejections": rejection_reasons,
    }
    dryrun_mod.append_jsonl(paths["events"], event)

    accepted_bar_keys = [str(x) for x in state.get("accepted_bar_keys", []) if x]
    executed_basket_ids = [str(x) for x in state.get("executed_basket_ids", []) if x]
    executed_intention_ids = [str(x) for x in state.get("executed_intention_ids", []) if x]
    bar_key = str(shadow_current.get("bar_key") or "")
    if allow_live_replay_same_bar and bar_key:
        accepted_bar_keys = [x for x in accepted_bar_keys if x != bar_key]
    should_consume_bar = bool(submit_stats.get("legs_submitted", 0) > 0 or pending_entries or live_positions)
    if should_consume_bar and bar_key and bar_key not in accepted_bar_keys:
        accepted_bar_keys.append(bar_key)
    if submit_stats.get("legs_submitted", 0) > 0 and basket_id and str(basket_id) not in executed_basket_ids:
        executed_basket_ids.append(str(basket_id))
    for row in [*pending_entries, *live_positions, *closed_trades]:
        intention_id = str(row.get("intention_id") or "")
        if intention_id and intention_id not in executed_intention_ids:
            executed_intention_ids.append(intention_id)
    accepted_bar_keys = accepted_bar_keys[-256:]
    executed_basket_ids = executed_basket_ids[-256:]
    executed_intention_ids = executed_intention_ids[-2048:]
    non_cooldown_rejection_reasons = [
        str(x.get("reason")) for x in rejection_reasons
        if str(x.get("reason") or "") and str(x.get("reason") or "") != "cooldown_active"
    ]
    active_state_basket_id = None
    if pending_entries or live_positions:
        active_basket_ids = {
            str(row.get("basket_id") or "")
            for row in [*pending_entries, *live_positions]
            if isinstance(row, dict) and str(row.get("basket_id") or "")
        }
        if active_basket_ids:
            active_state_basket_id = sorted(active_basket_ids)[0]
    current_basket_state = basket_runtime if basket_id else None
    if active_state_basket_id and active_state_basket_id != str(basket_id or ""):
        active_exchange_reconciliation = reconcile_exchange_positions(
            basket_id=active_state_basket_id,
            exchange_positions=exchange_open_positions,
            pending_entries=pending_entries,
            live_positions=live_positions,
            closed_trades=closed_trades,
            order_rows=orders,
            now_utc=run_at_utc,
        )
        active_parity_current, _active_parity_intentions = build_parity_current_for_basket(
            basket_id=active_state_basket_id,
            shadow_current=shadow_current,
            intentions=[*existing_intentions, *intentions],
        )
        active_submit_stats = derive_submit_stats_for_basket(
            basket_id=active_state_basket_id,
            intentions=[*existing_intentions, *intentions],
            pending_entries=pending_entries,
            live_positions=live_positions,
            closed_trades=closed_trades,
            orders=orders,
            leg_failures=leg_failures,
        )
        active_submit_stats["require_complete_basket"] = bool(cfg.get("basket_controls", {}).get("require_complete_basket", False))
        active_basket_parity = dryrun_mod.build_basket_parity_payload(
            current=active_parity_current or shadow_current,
            basket_metrics=((active_parity_current or {}).get("basket_metrics") or {}),
            intentions=[row for row in [*existing_intentions, *intentions] if isinstance(row, dict) and str(row.get("basket_id") or "") == active_state_basket_id],
            submitted_rows=[row for row in pending_entries if isinstance(row, dict) and str(row.get("basket_id") or "") == active_state_basket_id],
            live_rows=[row for row in live_positions if isinstance(row, dict) and str(row.get("basket_id") or "") == active_state_basket_id],
            closed_rows=[row for row in closed_trades if isinstance(row, dict) and str(row.get("basket_id") or "") == active_state_basket_id],
            leg_failures=[row for row in leg_failures if isinstance(row, dict) and str(row.get("basket_id") or "") == active_state_basket_id],
            submit_stats=active_submit_stats,
            fallback_taker_count=len([row for row in orders if isinstance(row, dict) and str(row.get("order_role") or "") == "entry_fallback" and str(row.get("basket_id") or "") == active_state_basket_id]),
            maker_reject_symbols=sorted({
                str(row.get("symbol") or "").upper()
                for row in orders
                if isinstance(row, dict)
                and str(row.get("basket_id") or "") == active_state_basket_id
                and str(row.get("order_role") or "") == "entry_rejected_post_only"
                and row.get("symbol")
            }),
            fallback_taker_symbols=sorted({
                str(row.get("symbol") or "").upper()
                for row in orders
                if isinstance(row, dict)
                and str(row.get("basket_id") or "") == active_state_basket_id
                and str(row.get("order_role") or "") == "entry_fallback"
                and row.get("symbol")
            }),
            suppression_reasons=[],
            exchange_positions=active_exchange_reconciliation["positions"],
        )
        active_decision_ts = (active_parity_current or {}).get("decision_ts")
        active_official_window = build_basket_entry_window_context(
            decision_ts=active_decision_ts,
            now_ts=run_now_ts,
            cfg=cfg,
        )
        active_basket_safety = classify_basket_safety(
            basket_id=active_state_basket_id,
            basket_runtime=summarize_basket_runtime(
                basket_id=active_state_basket_id,
                bar_key=(active_parity_current or {}).get("bar_key"),
                decision_ts=active_decision_ts,
                planned_exit_ts=(active_parity_current or {}).get("planned_exit_ts"),
                official_window=active_official_window,
                state=runtime_state,
                live_positions=live_positions,
                pending_entries=pending_entries,
                closed_trades=closed_trades,
                live_shell_armed=False,
                bridge_connected=bridge_connected,
                submit_stats=active_submit_stats,
                exchange_positions=active_exchange_reconciliation["positions"],
                exchange_reconciliation=active_exchange_reconciliation,
            ),
            basket_parity=active_basket_parity,
            reconciliation=active_exchange_reconciliation,
            cfg=cfg,
        )
        current_basket_state = summarize_basket_runtime(
            basket_id=active_state_basket_id,
            bar_key=(active_parity_current or {}).get("bar_key"),
            decision_ts=active_decision_ts,
            planned_exit_ts=(active_parity_current or {}).get("planned_exit_ts"),
            official_window=active_official_window,
            state=runtime_state,
            live_positions=live_positions,
            pending_entries=pending_entries,
            closed_trades=closed_trades,
            live_shell_armed=False,
            bridge_connected=bridge_connected,
            submit_stats=active_submit_stats,
            exchange_positions=active_exchange_reconciliation["positions"],
            exchange_reconciliation=active_exchange_reconciliation,
            basket_safety=active_basket_safety,
        )
    new_state = {
        "runner": "rank213_live_canary_shell",
        "last_run_at_utc": run_at_utc,
        "last_bar_key": bar_key or None,
        "last_decision_ts": shadow_current.get("decision_ts"),
        "last_event_kind": event["event_kind"],
        "accepted_last_run": accepted,
        "live_shell_armed": live_shell_armed,
        "accepted_bar_keys": accepted_bar_keys,
        "executed_basket_ids": executed_basket_ids,
        "executed_intention_ids": executed_intention_ids,
        "current_basket": current_basket_state,
        "current_decision_audit": current_decision_audit,
        "tracked_basket_outcome": tracked_basket_outcome if tracked_basket_id else None,
        "current_basket_parity": latest_basket_parity,
        "tracked_basket_parity": tracked_basket_parity if tracked_basket_id else None,
        "current_basket_safety": basket_safety if basket_id else None,
        "exchange_open_positions": exchange_reconciliation["positions"],
        "exchange_reconciliation": exchange_reconciliation,
        "pending_entries": pending_entries[-200:],
        "live_positions": live_positions[-100:],
        "closed_trades": closed_trades[-400:],
        "basket_flatten_reason": quarantine_flatten_reason,
        "flattened_live_count": flattened_live_count,
        "flattened_residual_count": flattened_residual_count,
        "residual_flatten_results": residual_flatten_results,
        "residual_flatten_history": residual_flatten_history,
        "residual_flatten_history_summary": residual_flatten_history_summary,
        "last_rejection_at_utc": run_at_utc if non_cooldown_rejection_reasons else state.get("last_rejection_at_utc"),
        "last_rejection_reasons": non_cooldown_rejection_reasons if non_cooldown_rejection_reasons else state.get("last_rejection_reasons", []),
    }
    dryrun_mod.save_json(paths["state"], new_state)

    config_path_display = str(Path(args.config).resolve().relative_to(ROOT)) if Path(args.config).resolve().is_relative_to(ROOT) else str(Path(args.config))

    status = {
        "strategy_id": cfg.get("meta", {}).get("strategy_id"),
        "mode": "live_canary_shell",
        "runner_script": "scripts/run_rank213_largecap_xs_jump_veto_live_canary.py",
        "config_path": config_path_display,
        "system_health": "unsafe_residual_exposure" if quarantine_flatten_reason else "ok",
        "trade_enabled": bool(cfg.get("safety", {}).get("trade_enabled", False)),
        "live_order_placement_enabled": bool(controls.get("live_order_placement_enabled", False)),
        "allow_live_flag": bool(args.allow_live),
        "live_shell_armed": live_shell_armed,
        "execution_bridge_connected": bridge_connected,
        "execution_bridge_mode": "rank213_horizon_runtime" if bridge_connected else "default_off_guarded_shell",
        "phase6_runtime": bridge_runtime_stats,
        "flattened_live_count": flattened_live_count,
        "flattened_residual_count": flattened_residual_count,
        "residual_flatten_results": residual_flatten_results,
        "residual_flatten_history": residual_flatten_history,
        "residual_flatten_history_summary": residual_flatten_history_summary,
        "last_run_utc": run_at_utc,
        "shadow_decision_ts": shadow_current.get("decision_ts"),
        "shadow_bar_key": shadow_current.get("bar_key"),
        "shadow_gate_on": shadow_current.get("gate_on"),
        "intentions_created": len(intentions),
        "orders_recorded": len(orders),
        "legs_attempted": submit_stats.get("legs_attempted", 0),
        "legs_submitted": submit_stats.get("legs_submitted", 0),
        "legs_submit_failed": submit_stats.get("legs_submit_failed", 0),
        "maker_reject_count": submit_stats.get("legs_failed_post_only", 0),
        "recent_reject_count": len(merged_rejections),
        "recent_intention_count": len(merged_intentions),
        "accepted": accepted,
        "pretrade_accepted": pretrade_accepted,
        "official_entry_window": official_window,
        "basket_runtime": basket_runtime,
        "basket_metrics": basket_metrics,
        "current_decision_audit": current_decision_audit,
        "tracked_basket_outcome": tracked_basket_outcome if tracked_basket_id else None,
        "current_basket_parity": latest_basket_parity,
        "tracked_basket_parity": tracked_basket_parity if tracked_basket_id else None,
        "basket_parity": latest_basket_parity,
        "basket_safety": basket_safety,
        "basket_comparable": bool((basket_runtime or {}).get("basket_comparable", submit_stats.get("basket_comparable", False))),
        "comparability_classification": str((basket_runtime or {}).get("comparability_classification") or ("comparable" if bool(submit_stats.get("basket_comparable", False)) else "incomplete_non_comparable")),
        "incomplete_basket": bool(int(submit_stats.get("legs_unmaterialized", 0) or 0) > 0),
        "materialized_leg_count": int(submit_stats.get("legs_materialized", 0) or 0),
        "unmaterialized_leg_count": int(submit_stats.get("legs_unmaterialized", 0) or 0),
        "unmaterialized_symbols": submit_stats.get("unmaterialized_symbols", []),
        "exchange_open_positions": exchange_reconciliation["positions"],
        "exchange_reconciliation": exchange_reconciliation,
        "cooldown": cooldown,
        "notes": [
            "This is the rank213 live canary shell; by default it stays in guarded mode and does not place real orders.",
            "To arm the shell, both config canary_controls.live_order_placement_enabled and --allow-live must be set.",
            "When armed, this script uses a minimal rank213 horizon runtime bridge for per-leg real entry submission while keeping default-off controls.",
        ],
    }
    dryrun_mod.save_json(paths["status"], status)

    operator_packet = {
        "generated_at_utc": run_at_utc,
        "strategy_id": cfg.get("meta", {}).get("strategy_id"),
        "operator_note": cfg.get("operator", {}).get("note"),
        "readiness_note": cfg.get("operator", {}).get("readiness_note"),
        "shadow_status": shadow_status,
        "shadow_current_decision": shadow_current,
        "shadow_warnings_visible": shadow_warnings,
        "live_shell_status": status,
        "basket_metrics": basket_metrics,
        "basket_runtime": basket_runtime,
        "current_decision_audit": current_decision_audit,
        "tracked_basket_outcome": tracked_basket_outcome if tracked_basket_id else None,
        "current_basket_parity": latest_basket_parity,
        "tracked_basket_parity": tracked_basket_parity if tracked_basket_id else None,
        "basket_parity": latest_basket_parity,
        "basket_safety": basket_safety,
        "basket_comparable": bool((basket_runtime or {}).get("basket_comparable", submit_stats.get("basket_comparable", False))),
        "comparability_classification": str((basket_runtime or {}).get("comparability_classification") or ("comparable" if bool(submit_stats.get("basket_comparable", False)) else "incomplete_non_comparable")),
        "incomplete_basket": bool(int(submit_stats.get("legs_unmaterialized", 0) or 0) > 0),
        "materialized_leg_count": int(submit_stats.get("legs_materialized", 0) or 0),
        "unmaterialized_leg_count": int(submit_stats.get("legs_unmaterialized", 0) or 0),
        "unmaterialized_symbols": submit_stats.get("unmaterialized_symbols", []),
        "exchange_open_positions": exchange_reconciliation["positions"],
        "exchange_reconciliation": exchange_reconciliation,
        "residual_flatten_results": residual_flatten_results,
        "residual_flatten_history": residual_flatten_history,
        "residual_flatten_history_summary": residual_flatten_history_summary,
        "cooldown": cooldown,
        "shadow_current_is_preview": bool(shadow_current.get("is_preview", False)),
        "live_shell_rejections": rejections,
        "leg_failures": leg_failures,
        "live_shell_warnings": warnings,
        "orders": orders,
        "execution_bridge": {
            "connected": bridge_connected,
            "mode": "rank213_horizon_runtime" if bridge_connected else "default_off_guarded_shell",
            "runtime_stats": {**bridge_runtime_stats, "flattened_live_count": flattened_live_count, "flattened_residual_count": flattened_residual_count, "residual_flatten_results": residual_flatten_results},
            "reuse_target": "rank213_native_horizon_exit",
            "bridge_wrapper_hooks": [
                "ensure_binance_leverage",
                "normalize_order_payload",
                "rank213_manage_pending_entries",
                "rank213_manage_live_positions",
            ],
            "maker_first": bool(cfg.get("execution", {}).get("maker_first", True)),
            "fallback_to_taker": bool(cfg.get("phase6", {}).get("entry", {}).get("fallback_to_market_on_ttl", True)),
        },
    }
    dryrun_mod.save_json(paths["operator_packet"], operator_packet)

    run_summary = {
        "generated_at_utc": run_at_utc,
        "runner": "rank213_live_canary_shell",
        "config_path": config_path_display,
        "accepted": accepted,
        "live_shell_armed": live_shell_armed,
        "intentions_created": len(intentions),
        "orders_recorded": len(orders),
        "rejections": len(rejections),
        "status_path": str(paths["status"].relative_to(ROOT)),
        "state_path": str(paths["state"].relative_to(ROOT)),
        "intentions_path": str(paths["intentions"].relative_to(ROOT)),
        "orders_path": str(paths["orders"].relative_to(ROOT)),
        "rejections_path": str(paths["rejections"].relative_to(ROOT)),
        "warnings_path": str(paths["warnings"].relative_to(ROOT)),
        "compare_path": str(paths["compare"].relative_to(ROOT)),
        "compare_summary_path": str(paths["compare_summary"].relative_to(ROOT)),
        "operator_packet_path": str(paths["operator_packet"].relative_to(ROOT)),
    }
    dryrun_mod.save_json(paths["run_summary"], run_summary)
    print(json.dumps(run_summary, ensure_ascii=False))
    return 0


if __name__ == "__main__":
    raise SystemExit(main())
