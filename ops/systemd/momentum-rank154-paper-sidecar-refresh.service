[Unit]
Description=Momentum Rank 154 daily forward paper runner
After=network-online.target
Wants=network-online.target

[Service]
Type=oneshot
WorkingDirectory=/root/clawd/jerry/momentum
ExecStart=/usr/bin/python3 /root/clawd/jerry/momentum/scripts/run_rank154_crypto_stat_arb_paper_sidecar_refresh.py --timer-unit momentum-rank154-paper-sidecar-refresh.timer
User=root
Group=root
Environment=PYTHONUNBUFFERED=1

[Install]
WantedBy=multi-user.target
