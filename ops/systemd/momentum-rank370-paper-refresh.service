[Unit]
Description=Momentum Rank 370 surface-mispricing paper runner
After=network-online.target
Wants=network-online.target

[Service]
Type=oneshot
WorkingDirectory=/root/clawd/jerry/momentum
ExecStart=/usr/bin/python3 /root/clawd/jerry/momentum/scripts/run_rank370_surface_mispricing_paper_runner.py --refresh --snapshot-csv /root/clawd/jerry/momentum/data/paper_snapshots/rank370_surface_snapshot.csv
User=root
Group=root
Environment=PYTHONUNBUFFERED=1

[Install]
WantedBy=multi-user.target
