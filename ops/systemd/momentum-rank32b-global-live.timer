[Unit]
Description=Run Momentum Rank32b global live lane on 15m official-close cadence

[Timer]
OnBootSec=4min
OnCalendar=*-*-* *:00:05
OnCalendar=*-*-* *:15:05
OnCalendar=*-*-* *:30:05
OnCalendar=*-*-* *:45:05
AccuracySec=1s
Unit=momentum-rank32b-global-live.service
Persistent=true

[Install]
WantedBy=timers.target
