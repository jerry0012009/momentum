[Unit]
Description=Momentum Rank32b Global strongest-only Live Lane
After=network-online.target
Wants=network-online.target

[Service]
Type=oneshot
WorkingDirectory=/root/clawd/jerry/momentum
ExecStart=/bin/bash -lc '/usr/bin/python3 /root/clawd/jerry/momentum/scripts/run_rank32b_global_live.py --config /root/clawd/jerry/momentum/config/execution/rank32b_canary.yaml --allow-live && /usr/bin/python3 /root/clawd/jerry/momentum/scripts/build_rank32b_global_live_dashboard.py && /usr/bin/python3 /root/clawd/jerry/momentum/scripts/build_rank32b_canary_dashboard.py && /bin/bash /root/clawd/jerry/momentum/scripts/publish_rank32b_canary_live.sh'
ExecStartPost=-/usr/bin/python3 /root/clawd/jerry/momentum/scripts/build_rank32b_live_shadow_ledger_compare.py
ExecStartPost=-/usr/bin/python3 /root/clawd/jerry/momentum/scripts/build_rank32b_live_shadow_diagnostic.py
ExecStartPost=-/usr/bin/python3 /root/clawd/jerry/momentum/scripts/build_rank32b_final_goal_gate.py
User=root
Environment=PYTHONUNBUFFERED=1

[Install]
WantedBy=multi-user.target
