[Unit]
Description=Momentum Rank213 live canary pending manager
After=network-online.target momentum-rank213-shadow-runner.service
Wants=network-online.target

[Service]
Type=oneshot
WorkingDirectory=/root/clawd/jerry/momentum
ExecStart=/bin/bash -lc '/usr/bin/python3 /root/clawd/jerry/momentum/scripts/run_rank213_largecap_xs_jump_veto_live_canary.py --config /root/clawd/jerry/momentum/config/execution/rank213_live_canary.yaml --allow-live --pending-only'
User=root
Group=root
Environment=PYTHONUNBUFFERED=1

[Install]
WantedBy=multi-user.target
