[Unit]
Description=Momentum Rank213 age90 live canary shell
After=network-online.target momentum-rank213-age90-shadow-runner.service
Wants=network-online.target

[Service]
Type=oneshot
WorkingDirectory=/root/clawd/jerry/momentum
ExecStart=/bin/bash -lc '/usr/bin/python3 /root/clawd/jerry/momentum/scripts/run_rank213_age90_live_canary.py --allow-live'
User=root
Group=root
Environment=PYTHONUNBUFFERED=1

[Install]
WantedBy=multi-user.target
