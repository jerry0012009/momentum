[Unit]
Description=Momentum 32B Canary TODO editor
After=network.target

[Service]
Type=simple
User=root
WorkingDirectory=/root/clawd/jerry/momentum
ExecStart=/root/clawd/jerry/momentum/.venv/bin/python /root/clawd/jerry/momentum/scripts/canary_doc_editor.py --host 0.0.0.0 --port 24444 --doc /root/clawd/jerry/momentum/docs/CANARY_32B_TODO.md --token-file /root/clawd/jerry/momentum/var/canary_editor_token.txt
Restart=always
RestartSec=3
Nice=10
IOSchedulingClass=best-effort
IOSchedulingPriority=7

[Install]
WantedBy=multi-user.target
