[Unit]
Description=Momentum Rank 427 high-volume selloff bounce paper runner
After=network-online.target
Wants=network-online.target

[Service]
Type=oneshot
WorkingDirectory=/root/clawd/jerry/momentum
ExecStart=/usr/bin/python3 /root/clawd/jerry/momentum/scripts/run_rank427_highvol_selloff_bounce_paper_runner.py --refresh
User=root
Group=root
Environment=PYTHONUNBUFFERED=1

[Install]
WantedBy=multi-user.target
