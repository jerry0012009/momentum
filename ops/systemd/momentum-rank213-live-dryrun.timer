[Unit]
Description=Run Momentum Rank213 live dry-run lane on 15m official-close cadence

[Timer]
OnBootSec=5min
OnCalendar=*-*-* *:02:05
OnCalendar=*-*-* *:17:05
OnCalendar=*-*-* *:32:05
OnCalendar=*-*-* *:47:05
AccuracySec=1s
Unit=momentum-rank213-live-dryrun.service
Persistent=true

[Install]
WantedBy=timers.target
