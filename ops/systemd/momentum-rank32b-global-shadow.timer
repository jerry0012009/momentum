[Unit]
Description=Run Momentum Rank32b global strongest-only shadow on 15m cadence

[Timer]
OnBootSec=3min
OnCalendar=*-*-* *:00:23
OnCalendar=*-*-* *:15:23
OnCalendar=*-*-* *:30:23
OnCalendar=*-*-* *:45:23
AccuracySec=1s
Unit=momentum-rank32b-global-shadow.service
Persistent=true

[Install]
WantedBy=timers.target
