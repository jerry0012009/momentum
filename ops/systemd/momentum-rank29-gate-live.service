[Unit]
Description=Momentum rank29 gate live 100u lane
After=network-online.target
Wants=network-online.target

[Service]
Type=oneshot
WorkingDirectory=/root/clawd/jerry/momentum
Environment=PYTHONPATH=/root/clawd/jerry/momentum/src
ExecStart=/usr/bin/env python3 /root/clawd/jerry/momentum/scripts/run_rank29_gate_live.py --config /root/clawd/jerry/momentum/config/execution/rank29_gate_live.yaml --allow-live
