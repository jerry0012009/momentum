[Unit]
Description=Momentum Rank32b Global strongest-only Shadow
After=network-online.target
Wants=network-online.target

[Service]
Type=oneshot
WorkingDirectory=/root/clawd/jerry/momentum
ExecStart=/bin/bash -lc '/usr/bin/python3 /root/clawd/jerry/momentum/scripts/run_rank32b_global_selector_shadow.py --config /root/clawd/jerry/momentum/config/execution/rank32b_canary.yaml && /usr/bin/python3 /root/clawd/jerry/momentum/scripts/build_rank32b_global_selector_shadow_dashboard.py && /bin/bash /root/clawd/jerry/momentum/scripts/publish_rank32b_shadow_global_winner.sh'
User=root
Environment=PYTHONUNBUFFERED=1

[Install]
WantedBy=multi-user.target
