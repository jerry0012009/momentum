[Unit]
Description=Run Momentum Rank213 raw-bar shadow runner on 15m cadence

[Timer]
OnBootSec=4min
OnCalendar=*-*-* *:00:06
OnCalendar=*-*-* *:15:06
OnCalendar=*-*-* *:30:06
OnCalendar=*-*-* *:45:06
AccuracySec=1s
Unit=momentum-rank213-shadow-runner.service
Persistent=true

[Install]
WantedBy=timers.target
