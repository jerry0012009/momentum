[Unit]
Description=Momentum Rank213 raw-bar shadow runner
After=network-online.target
Wants=network-online.target

[Service]
Type=oneshot
WorkingDirectory=/root/clawd/jerry/momentum
ExecStart=/bin/bash -lc '/usr/bin/python3 /root/clawd/jerry/momentum/scripts/run_rank213_largecap_xs_jump_veto_shadow_runner.py'
User=root
Group=root
Environment=PYTHONUNBUFFERED=1

[Install]
