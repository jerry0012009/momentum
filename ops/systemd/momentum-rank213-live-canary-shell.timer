[Unit]
Description=Run Momentum Rank213 live canary shell on 15m official-close cadence

[Timer]
OnBootSec=6min
OnCalendar=*-*-* *:02:15
OnCalendar=*-*-* *:17:15
OnCalendar=*-*-* *:32:15
OnCalendar=*-*-* *:47:15
AccuracySec=1s
Unit=momentum-rank213-live-canary-shell.service
Persistent=true

[Install]
WantedBy=timers.target
