[Unit]
Description=Momentum Rank29 orderbook shadow runner
After=network-online.target
Wants=network-online.target

[Service]
Type=oneshot
WorkingDirectory=/root/clawd/jerry/momentum
ExecStart=/usr/bin/python3 /root/clawd/jerry/momentum/scripts/run_rank29_orderbook_shadow_runner.py
User=root
Group=root
Environment=PYTHONUNBUFFERED=1

[Install]
WantedBy=multi-user.target
