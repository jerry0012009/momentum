[Unit]
Description=Momentum Rank 382 liquidity-volatility x illiquidity-level XS paper runner
After=network-online.target
Wants=network-online.target

[Service]
Type=oneshot
WorkingDirectory=/root/clawd/jerry/momentum
ExecStart=/usr/bin/python3 /root/clawd/jerry/momentum/scripts/run_rank382_liquidityvol_illiqlevel_paper_runner.py --refresh
User=root
Group=root
